    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Reality"
    }
  },
  "verses": [
    {
      "id": 5324,
      "verse_number": 1,
      "verse_key": "69:1",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱلْحَآقَّةُ",
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 407027,
          "resource_id": 85,
          "text": "The Inevitable Hour!"
        },
        {
          "id": 1549761,
          "resource_id": 831,
          "text": "Honi shudhni ! (indubitable) [sach-much honay wali]"
        }
      ]
    },
    {
      "id": 5325,
      "verse_number": 2,
      "verse_key": "69:2",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَا ٱلْحَآقَّةُ",
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 407028,
          "resource_id": 85,
          "text": "What is the Inevitable Hour?"
        },
        {
          "id": 1549762,
          "resource_id": 831,
          "text": "Kya hai woh honi shudni (indubitable)"
        }
      ]
    },
    {
      "id": 5326,
      "verse_number": 3,
      "verse_key": "69:3",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ",
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 407029,
          "resource_id": 85,
          "text": "What will explain to you what the Inevitable Hour is?"
        },
        {
          "id": 1549763,
          "resource_id": 831,
          "text": "Aur tum kya jaano ke woh kya hai honi shudhni (indubitable)"
        }
      ]
    },
    {
      "id": 5327,
      "verse_number": 4,
      "verse_key": "69:4",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 407030,
          "resource_id": 85,
          "text": "The people of Thamud and 'Ad denied that the crashing blow would come:"
        },
        {
          "id": 1549764,
          "resource_id": 831,
          "text": "Samood aur Aad ne us achanak toot padne wali aafat ko jhutlaya"
        }
      ]
    },
    {
      "id": 5328,
      "verse_number": 5,
      "verse_key": "69:5",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 407031,
          "resource_id": 85,
          "text": "Thamud was destroyed by a deafening blast;"
        },
        {
          "id": 1549765,
          "resource_id": 831,
          "text": "To Samood ek sakht haadse mein halaaq kiye gaye"
        }
      ]
    },
    {
      "id": 5329,
      "verse_number": 6,
      "verse_key": "69:6",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 407032,
          "resource_id": 85,
          "text": "Ad was destroyed by a furious wind"
        },
        {
          "id": 1549766,
          "resource_id": 831,
          "text": "Aur Aad ek badi shadeed toofani aandhi(storm) se tabah kardiye gaye"
        }
      ]
    },
    {
      "id": 5330,
      "verse_number": 7,
      "verse_key": "69:7",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ",
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 407033,
          "resource_id": 85,
          "text": "that God let loose against them for seven consecutive nights, eight consecutive days, so that you could have seen its people lying dead like hollow palm-trunks."
        },
        {
          "id": 1549767,
          "resource_id": 831,
          "text": "Allah taala ne usko musalsal saat (seven) raat aur aath (eight) din unpar musallat rakkha (tum wahan hotey to) dekhte ke woh wahan is tarah pachade paday jaise woh khajoor ke boseeda (rotten) taney (trunks) hon"
        }
      ]
    },
    {
      "id": 5331,
      "verse_number": 8,
      "verse_key": "69:8",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ",
      "page_number": 566,
      "juz_number": 29,
      "translations": [
        {
          "id": 407034,
          "resource_id": 85,
          "text": "Can you see any trace of them now?"
        },
        {
          "id": 1549768,
          "resource_id": 831,
          "text": "Ab kya unmein se koi tumhein baki nazar aata hai"
        }
      ]
    },
    {
      "id": 5332,
      "verse_number": 9,
      "verse_key": "69:9",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407035,
          "resource_id": 85,
          "text": "And there came Pharaoh and those before him and the overturned cities with sin."
        },
        {
          "id": 1549769,
          "resource_id": 831,
          "text": "Aur isi khata-e-azeem ka irtiqaab Firoun aur ussey pehle ke logon ne aur talpat (overturned) ho janey wali bastiyon ne kiya"
        }
      ]
    },
    {
      "id": 5333,
      "verse_number": 10,
      "verse_key": "69:10",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407036,
          "resource_id": 85,
          "text": "these people committed grave sins and disobeyed the messenger of their Lord, so He seized them with an ever-tightening grip."
        },
        {
          "id": 1549770,
          "resource_id": 831,
          "text": "Un sab ne apne Rubb ke Rasool ki baat na maani to usne unko bade sakhti ke saath pakda"
        }
      ]
    },
    {
      "id": 5334,
      "verse_number": 11,
      "verse_key": "69:11",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى ٱلْجَارِيَةِ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407037,
          "resource_id": 85,
          "text": "But when the Flood rose high, We saved you in the floating ship,"
        },
        {
          "id": 1549771,
          "resource_id": 831,
          "text": "Jab pani ka toofan hadd se guzar gaya to humne tumko kashti mein sawar kardiya tha"
        }
      ]
    },
    {
      "id": 5335,
      "verse_number": 12,
      "verse_key": "69:12",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407038,
          "resource_id": 85,
          "text": "making that event a reminder for you: attentive ears may take heed."
        },
        {
          "id": 1549772,
          "resource_id": 831,
          "text": "Taa-ke is waqiye ko tumhare liye ek sabaq-aamoz yaadgaar bana dein aur yaad rakhne waley kaan iski yaad mehfooz rakkhein"
        }
      ]
    },
    {
      "id": 5336,
      "verse_number": 13,
      "verse_key": "69:13",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407039,
          "resource_id": 85,
          "text": "When the Trumpet is sounded a single time,"
        },
        {
          "id": 1549773,
          "resource_id": 831,
          "text": "Phir jab ek dafa sur mein phoonk maar di jayegi"
        }
      ]
    },
    {
      "id": 5337,
      "verse_number": 14,
      "verse_key": "69:14",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407040,
          "resource_id": 85,
          "text": "when the earth and its mountains are raised high and then crushed with a single blow,"
        },
        {
          "id": 1549774,
          "resource_id": 831,
          "text": "Aur zameen aur pahadon ko utha kar ek hi chot mein reza reza kardiya jayega"
        }
      ]
    },
    {
      "id": 5338,
      "verse_number": 15,
      "verse_key": "69:15",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407041,
          "resource_id": 85,
          "text": "on that Day the Great Event will come to pass."
        },
        {
          "id": 1549775,
          "resource_id": 831,
          "text": "Us roz woh honay wala waqiya pesh aa jayega"
        }
      ]
    },
    {
      "id": 5339,
      "verse_number": 16,
      "verse_key": "69:16",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407042,
          "resource_id": 85,
          "text": "The sky will be torn apart on that Day, it will be so frail."
        },
        {
          "id": 1549776,
          "resource_id": 831,
          "text": "Usdin Aasmaan phatega aur uski bandish dhili padh jayegi"
        }
      ]
    },
    {
      "id": 5340,
      "verse_number": 17,
      "verse_key": "69:17",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَـٰنِيَةٌ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407043,
          "resource_id": 85,
          "text": "The angels will be on all sides of it and, on that Day, eight of them will bear the throne of your Lord above them."
        },
        {
          "id": 1549777,
          "resource_id": 831,
          "text": "Farishtey uske atraf-o-jawanib mein hongey aur aat (eight) farishtey us roz tere Rubb ka arsh apne upar uthaye huey hongey"
        }
      ]
    },
    {
      "id": 5341,
      "verse_number": 18,
      "verse_key": "69:18",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407044,
          "resource_id": 85,
          "text": "On that Day you will be brought to judgement and none of your secrets will remain hidden."
        },
        {
          "id": 1549778,
          "resource_id": 831,
          "text": "Woh din hoga jab tumlog pesh kiye jaogey, tumhara koi raaz bhi chupa na reh jayega"
        }
      ]
    },
    {
      "id": 5342,
      "verse_number": 19,
      "verse_key": "69:19",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَـٰبِيَهْ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407045,
          "resource_id": 85,
          "text": "Anyone who is given his Record in his right hand will say, ‘Here is my Record, read it."
        },
        {
          "id": 1549779,
          "resource_id": 831,
          "text": "Us waqt jiska naam-e-aamal uske seedhey haath mein diya jayega woh kahega “lo dekho, padho mera naam-e-aamal"
        }
      ]
    },
    {
      "id": 5343,
      "verse_number": 20,
      "verse_key": "69:20",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنِّى ظَنَنتُ أَنِّى مُلَـٰقٍ حِسَابِيَهْ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407046,
          "resource_id": 85,
          "text": "I knew I would meet my Reckoning,’"
        },
        {
          "id": 1549780,
          "resource_id": 831,
          "text": "Main samajhta tha ke mujhey zaroor apna hisaab milne wala hai”"
        }
      ]
    },
    {
      "id": 5344,
      "verse_number": 21,
      "verse_key": "69:21",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407047,
          "resource_id": 85,
          "text": "and so he will have a pleasant life"
        },
        {
          "id": 1549781,
          "resource_id": 831,
          "text": "Pas woh dil pasand aish mein hoga"
        }
      ]
    },
    {
      "id": 5345,
      "verse_number": 22,
      "verse_key": "69:22",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى جَنَّةٍ عَالِيَةٍ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407048,
          "resource_id": 85,
          "text": "in a lofty Garden,"
        },
        {
          "id": 1549782,
          "resource_id": 831,
          "text": "Aali muqaam jannat mein"
        }
      ]
    },
    {
      "id": 5346,
      "verse_number": 23,
      "verse_key": "69:23",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قُطُوفُهَا دَانِيَةٌ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407049,
          "resource_id": 85,
          "text": "with clustered fruit within his reach."
        },
        {
          "id": 1549783,
          "resource_id": 831,
          "text": "Jiske phalon ke guchhey jhuke padh rahey hongey"
        }
      ]
    },
    {
      "id": 5347,
      "verse_number": 24,
      "verse_key": "69:24",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407050,
          "resource_id": 85,
          "text": "It will be said, ‘Eat and drink to your heart’s content as a reward for what you have done in days gone by.’"
        },
        {
          "id": 1549784,
          "resource_id": 831,
          "text": "(Aise logon se kaha jayega) mazey se khao aur pio apne un aamal ke badle jo tumne guzre huey dino mein kiye hain"
        }
      ]
    },
    {
      "id": 5348,
      "verse_number": 25,
      "verse_key": "69:25",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى لَمْ أُوتَ كِتَـٰبِيَهْ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407051,
          "resource_id": 85,
          "text": "But anyone who is given his Record in his left hand will say, ‘If only I had never been given any Record"
        },
        {
          "id": 1549785,
          "resource_id": 831,
          "text": "Aur jiska naam-e-aamal uske bayein (left) haath mein diya jayega woh kahega “ kaash mera aamal nama mujhey na diya gaya hota"
        }
      ]
    },
    {
      "id": 5349,
      "verse_number": 26,
      "verse_key": "69:26",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407052,
          "resource_id": 85,
          "text": "and knew nothing of my Reckoning."
        },
        {
          "id": 1549786,
          "resource_id": 831,
          "text": "Aur main na jaanta ke mera hisaab kya hai"
        }
      ]
    },
    {
      "id": 5350,
      "verse_number": 27,
      "verse_key": "69:27",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَـٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407053,
          "resource_id": 85,
          "text": "How I wish death had been the end of me."
        },
        {
          "id": 1549787,
          "resource_id": 831,
          "text": "Kaash meri wahi maut (jo duniya mei aayi thi) faisla-kun hoti"
        }
      ]
    },
    {
      "id": 5351,
      "verse_number": 28,
      "verse_key": "69:28",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407054,
          "resource_id": 85,
          "text": "My wealth has been no use to me,"
        },
        {
          "id": 1549788,
          "resource_id": 831,
          "text": "Aaj mera maal mere kuch kaam na aaya"
        }
      ]
    },
    {
      "id": 5352,
      "verse_number": 29,
      "verse_key": "69:29",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَلَكَ عَنِّى سُلْطَـٰنِيَهْ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407055,
          "resource_id": 85,
          "text": "and my power has vanished.’"
        },
        {
          "id": 1549789,
          "resource_id": 831,
          "text": "Mera sara iqtedaar khatam ho gaya"
        }
      ]
    },
    {
      "id": 5353,
      "verse_number": 30,
      "verse_key": "69:30",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خُذُوهُ فَغُلُّوهُ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407056,
          "resource_id": 85,
          "text": "‘Take him, put a collar on him,"
        },
        {
          "id": 1549790,
          "resource_id": 831,
          "text": "(hukum hoga) pakdo isey aur iski gardan mei touk daal do"
        }
      ]
    },
    {
      "id": 5354,
      "verse_number": 31,
      "verse_key": "69:31",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407057,
          "resource_id": 85,
          "text": "lead him to burn in the blazing Fire,"
        },
        {
          "id": 1549791,
          "resource_id": 831,
          "text": "Phir isey jahannum mein jhoonk do"
        }
      ]
    },
    {
      "id": 5355,
      "verse_number": 32,
      "verse_key": "69:32",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407058,
          "resource_id": 85,
          "text": "and [bind him] in a chain seventy metres long:"
        },
        {
          "id": 1549792,
          "resource_id": 831,
          "text": "Phir isko satter(seventy) haath lambi zanjeer mei jakad do"
        }
      ]
    },
    {
      "id": 5356,
      "verse_number": 33,
      "verse_key": "69:33",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407059,
          "resource_id": 85,
          "text": "he would not believe in Almighty God,"
        },
        {
          "id": 1549793,
          "resource_id": 831,
          "text": "Yeh na Allah buzurg-o-bartar par iman lata tha"
        }
      ]
    },
    {
      "id": 5357,
      "verse_number": 34,
      "verse_key": "69:34",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "page_number": 567,
      "juz_number": 29,
      "translations": [
        {
          "id": 407060,
          "resource_id": 85,
          "text": "he never encouraged feeding the hungry,"
        },
        {
          "id": 1549794,
          "resource_id": 831,
          "text": "Aur na miskeen ko khana khilane ki targeeb deta tha"
        }
      ]
    },
    {
      "id": 5358,
      "verse_number": 35,
      "verse_key": "69:35",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407061,
          "resource_id": 85,
          "text": "so today he has no real friend here,"
        },
        {
          "id": 1549795,
          "resource_id": 831,
          "text": "Lihaza aaj na yahan iska koi yaar-e-gamkhaar hai"
        }
      ]
    },
    {
      "id": 5359,
      "verse_number": 36,
      "verse_key": "69:36",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407062,
          "resource_id": 85,
          "text": "and the only food he has is the filth"
        },
        {
          "id": 1549796,
          "resource_id": 831,
          "text": "Aur na zakhmon ke dhowan (washing of wounds) ke siwa iske liye koi khana"
        }
      ]
    },
    {
      "id": 5360,
      "verse_number": 37,
      "verse_key": "69:37",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 502,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407063,
          "resource_id": 85,
          "text": "that only sinners eat.’"
        },
        {
          "id": 1549797,
          "resource_id": 831,
          "text": "Jisey khatakaaron (sinners) ke siwa koi nahin khata"
        }
      ]
    },
    {
      "id": 5361,
      "verse_number": 38,
      "verse_key": "69:38",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407064,
          "resource_id": 85,
          "text": "So I swear by what you can see"
        },
        {
          "id": 1549798,
          "resource_id": 831,
          "text": "Pas nahin, main qasam khata hoon un cheezon ki bhi jo tum dekhte ho"
        }
      ]
    },
    {
      "id": 5362,
      "verse_number": 39,
      "verse_key": "69:39",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا لَا تُبْصِرُونَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407065,
          "resource_id": 85,
          "text": "and by what you cannot see:"
        },
        {
          "id": 1549799,
          "resource_id": 831,
          "text": "Aur unki bhi jinhein tum nahin dekhte"
        }
      ]
    },
    {
      "id": 5363,
      "verse_number": 40,
      "verse_key": "69:40",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407066,
          "resource_id": 85,
          "text": "this [Quran] is the speech of an honoured messenger,"
        },
        {
          "id": 1549800,
          "resource_id": 831,
          "text": "Yeh ek Rasool-e-kareem ka qaul ( speech ) hai"
        }
      ]
    },
    {
      "id": 5364,
      "verse_number": 41,
      "verse_key": "69:41",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407067,
          "resource_id": 85,
          "text": "not the words of a poet- how little you believe!-"
        },
        {
          "id": 1549801,
          "resource_id": 831,
          "text": "Kisi shayar ka qaul nahin hai, tumlog kam hi iman latey ho"
        }
      ]
    },
    {
      "id": 5365,
      "verse_number": 42,
      "verse_key": "69:42",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407068,
          "resource_id": 85,
          "text": "nor the words of a soothsayer- how little you reflect!"
        },
        {
          "id": 1549802,
          "resource_id": 831,
          "text": "Aur na yeh kisi kaahin(soothsayer) ka qaul hai , tum log kam hi gaur karte ho"
        }
      ]
    },
    {
      "id": 5366,
      "verse_number": 43,
      "verse_key": "69:43",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407069,
          "resource_id": 85,
          "text": "This [Quran] is a message sent down from the Lord of the Worlds:"
        },
        {
          "id": 1549803,
          "resource_id": 831,
          "text": "Yeh Rabb-ul alameen ki taraf se nazil huwa hai"
        }
      ]
    },
    {
      "id": 5367,
      "verse_number": 44,
      "verse_key": "69:44",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407070,
          "resource_id": 85,
          "text": "if [the Prophet] had attributed some fabrication to Us,"
        },
        {
          "id": 1549804,
          "resource_id": 831,
          "text": "Aur agar is (Nabi) ne khud ghad kar koi baat hamari taraf mansook ki hoti"
        }
      ]
    },
    {
      "id": 5368,
      "verse_number": 45,
      "verse_key": "69:45",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407071,
          "resource_id": 85,
          "text": "We would certainly have seized his right hand"
        },
        {
          "id": 1549805,
          "resource_id": 831,
          "text": "To hum iska dayan(right) haath padkad letay"
        }
      ]
    },
    {
      "id": 5369,
      "verse_number": 46,
      "verse_key": "69:46",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407072,
          "resource_id": 85,
          "text": "and cut off his lifeblood,"
        },
        {
          "id": 1549806,
          "resource_id": 831,
          "text": "Aur iski rag-e-gardan (life vein) kaat daalte"
        }
      ]
    },
    {
      "id": 5370,
      "verse_number": 47,
      "verse_key": "69:47",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407073,
          "resource_id": 85,
          "text": "and none of you could have defended him."
        },
        {
          "id": 1549807,
          "resource_id": 831,
          "text": "Phir tum mein se koi (humein)is kaam se rokne wala na hota"
        }
      ]
    },
    {
      "id": 5371,
      "verse_number": 48,
      "verse_key": "69:48",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407074,
          "resource_id": 85,
          "text": "This [Quran] is a reminder for those who are aware of God."
        },
        {
          "id": 1549808,
          "resource_id": 831,
          "text": "Dar haqeeqat yeh parheizgar logon ke liye ek naseehat hai"
        }
      ]
    },
    {
      "id": 5372,
      "verse_number": 49,
      "verse_key": "69:49",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407075,
          "resource_id": 85,
          "text": "We know that some of you consider it to be lies-"
        },
        {
          "id": 1549809,
          "resource_id": 831,
          "text": "Aur hum jante hain ke tum mein se kuch log jhutlane waley hain"
        }
      ]
    },
    {
      "id": 5373,
      "verse_number": 50,
      "verse_key": "69:50",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407076,
          "resource_id": 85,
          "text": "this will be a source of bitter regret for the disbelievers-"
        },
        {
          "id": 1549810,
          "resource_id": 831,
          "text": "Aise kafiron ke liye yaqeenan yeh mujeeb-e-hasrat (cause of regret) hai"
        }
      ]
    },
    {
      "id": 5374,
      "verse_number": 51,
      "verse_key": "69:51",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407077,
          "resource_id": 85,
          "text": "but it is in fact the certain Truth."
        },
        {
          "id": 1549811,
          "resource_id": 831,
          "text": "Aur yeh bilkul yaqeeni haqq hai"
        }
      ]
    },
    {
      "id": 5375,
      "verse_number": 52,
      "verse_key": "69:52",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 503,
      "manzil_number": 7,
      "sajdah_number": null,
