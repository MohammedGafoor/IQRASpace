{
  "syncedAt": "2026-08-31T09:57:51.848Z",
  "chapter": {
    "id": 92,
    "revelation_place": "makkah",
    "revelation_order": 9,
    "bismillah_pre": true,
    "name_simple": "Al-Layl",
    "name_complex": "Al-Layl",
    "name_arabic": "الليل",
    "verses_count": 21,
    "pages": [
      595,
      596
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Night"
    }
  },
  "verses": [
    {
      "id": 6059,
      "verse_number": 1,
      "verse_key": "92:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407762,
          "resource_id": 85,
          "text": "By the enshrouding night,"
        },
        {
          "id": 1550496,
          "resource_id": 831,
          "text": "Kasam hai raat ki jabke woh chaa jaaye"
        }
      ]
    },
    {
      "id": 6060,
      "verse_number": 2,
      "verse_key": "92:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407763,
          "resource_id": 85,
          "text": "by the radiant day,"
        },
        {
          "id": 1550497,
          "resource_id": 831,
          "text": "Aur din ki jabke woh roshan ho"
        }
      ]
    },
    {
      "id": 6061,
      "verse_number": 3,
      "verse_key": "92:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407764,
          "resource_id": 85,
          "text": "by His creation of male and female!"
        },
        {
          "id": 1550498,
          "resource_id": 831,
          "text": "Aur us zaat ki jisne nar(male) aur maada(female) ko paida kiya"
        }
      ]
    },
    {
      "id": 6062,
      "verse_number": 4,
      "verse_key": "92:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407765,
          "resource_id": 85,
          "text": "The ways you take differ greatly."
        },
        {
          "id": 1550499,
          "resource_id": 831,
          "text": "Dar haqeeqat tum logon ki koshishein mukhtalif qism ki hai"
        }
      ]
    },
    {
      "id": 6063,
      "verse_number": 5,
      "verse_key": "92:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407766,
          "resource_id": 85,
          "text": "There is the one who gives, who is mindful of God,"
        },
        {
          "id": 1550500,
          "resource_id": 831,
          "text": "To jisne (rah e khuda mein) maal diya aur (khuda ki nafarmani se) parhez kiya"
        }
      ]
    },
    {
      "id": 6064,
      "verse_number": 6,
      "verse_key": "92:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407767,
          "resource_id": 85,
          "text": "who testifies to goodness––"
        },
        {
          "id": 1550501,
          "resource_id": 831,
          "text": "Aur bhalayi ko sach mana"
        }
      ]
    },
    {
      "id": 6065,
      "verse_number": 7,
      "verse_key": "92:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407768,
          "resource_id": 85,
          "text": "We shall smooth his way towards ease."
        },
        {
          "id": 1550502,
          "resource_id": 831,
          "text": "Usko hum aasan raastey kay liye sahulat denge"
        }
      ]
    },
    {
      "id": 6066,
      "verse_number": 8,
      "verse_key": "92:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407769,
          "resource_id": 85,
          "text": "There is the one who is miserly, who is self-satisfied,"
        },
        {
          "id": 1550503,
          "resource_id": 831,
          "text": "Aur jisne bukhl(kanjoosi) kiya aur (apney khuda se) be niyazi(self-sufficient/independent) barti"
        }
      ]
    },
    {
      "id": 6067,
      "verse_number": 9,
      "verse_key": "92:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407770,
          "resource_id": 85,
          "text": "who denies goodness––"
        },
        {
          "id": 1550504,
          "resource_id": 831,
          "text": "aur bhalayi ko jhutlaya"
        }
      ]
    },
    {
      "id": 6068,
      "verse_number": 10,
      "verse_key": "92:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407771,
          "resource_id": 85,
          "text": "We shall smooth his way towards hardship"
        },
        {
          "id": 1550505,
          "resource_id": 831,
          "text": "Usko hum sakht rastey kay liye sahulat dengey"
        }
      ]
    },
    {
      "id": 6069,
      "verse_number": 11,
      "verse_key": "92:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407772,
          "resource_id": 85,
          "text": "and his wealth will not help him as he falls."
        },
        {
          "id": 1550506,
          "resource_id": 831,
          "text": "Aur uska maal aakhir uske kis kaam aayega jabke woh halaq ho jaye"
        }
      ]
    },
    {
      "id": 6070,
      "verse_number": 12,
      "verse_key": "92:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407773,
          "resource_id": 85,
          "text": "Our part is to provide guidance––"
        },
        {
          "id": 1550507,
          "resource_id": 831,
          "text": "Beshak rasta batana hamare zimmey hai"
        }
      ]
    },
    {
      "id": 6071,
      "verse_number": 13,
      "verse_key": "92:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407774,
          "resource_id": 85,
          "text": "this world and the next belong to Us––"
        },
        {
          "id": 1550508,
          "resource_id": 831,
          "text": "aur dar haqeeqat aakhirat aur duniya dono kay hum hi malik hai"
        }
      ]
    },
    {
      "id": 6072,
      "verse_number": 14,
      "verse_key": "92:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407775,
          "resource_id": 85,
          "text": "so I warn you about the raging Fire,"
        },
        {
          "id": 1550509,
          "resource_id": 831,
          "text": "Pas maine tumko khabardar kar diya hai bhadakti hui aag se"
        }
      ]
    },
    {
      "id": 6073,
      "verse_number": 15,
      "verse_key": "92:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407776,
          "resource_id": 85,
          "text": "in which none but the most wicked one will burn,"
        },
        {
          "id": 1550510,
          "resource_id": 831,
          "text": "Usmein nahin jhulsega magar woh intihayi badbakth"
        }
      ]
    },
    {
      "id": 6074,
      "verse_number": 16,
      "verse_key": "92:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407777,
          "resource_id": 85,
          "text": "who denied [the truth], and turned away."
        },
        {
          "id": 1550511,
          "resource_id": 831,
          "text": "jisne jhutlaya aur mooh phera"
        }
      ]
    },
    {
      "id": 6075,
      "verse_number": 17,
      "verse_key": "92:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407778,
          "resource_id": 85,
          "text": "The most pious one will be spared this––"
        },
        {
          "id": 1550512,
          "resource_id": 831,
          "text": "Aur usse door rakkha jayega woh nihayat parhezgaar"
        }
      ]
    },
    {
      "id": 6076,
      "verse_number": 18,
      "verse_key": "92:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407779,
          "resource_id": 85,
          "text": "who gives his wealth away as self-purification,"
        },
        {
          "id": 1550513,
          "resource_id": 831,
          "text": "Jo paakiza honay ki khatir apna maal deta hai"
        }
      ]
    },
    {
      "id": 6077,
      "verse_number": 19,
      "verse_key": "92:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407780,
          "resource_id": 85,
          "text": "not to return a favour to anyone"
        },
        {
          "id": 1550514,
          "resource_id": 831,
          "text": "Uspar kisi ka koi ehsan nahin hai jiska badla usey dena ho"
        }
      ]
    },
    {
      "id": 6078,
      "verse_number": 20,
      "verse_key": "92:20",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407781,
          "resource_id": 85,
          "text": "but for the sake of his Lord the Most High––"
        },
        {
          "id": 1550515,
          "resource_id": 831,
          "text": "Woh to sirf apne Rubb-e-bartrar ki raza joii ke liye yeh kaam karta hai"
        }
      ]
    },
    {
      "id": 6079,
      "verse_number": 21,
      "verse_key": "92:21",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَسَوْفَ يَرْضَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407782,
          "resource_id": 85,
          "text": "and he will be well pleased."
        },
        {
          "id": 1550516,
          "resource_id": 831,
          "text": "Aur zaroor woh (us se) khush hoga"
        }
      ]
    }
  ]
}