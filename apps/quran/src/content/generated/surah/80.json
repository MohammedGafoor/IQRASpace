{
  "syncedAt": "2026-08-31T09:57:46.689Z",
  "chapter": {
    "id": 80,
    "revelation_place": "makkah",
    "revelation_order": 24,
    "bismillah_pre": true,
    "name_simple": "'Abasa",
    "name_complex": "`Abasa",
    "name_arabic": "عبس",
    "verses_count": 42,
    "pages": [
      585,
      585
    ],
    "translated_name": {
      "language_name": "english",
      "name": "He Frowned"
    }
  },
  "verses": [
    {
      "id": 5759,
      "verse_number": 1,
      "verse_key": "80:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " عَبَسَ وَتَوَلَّىٰٓ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407462,
          "resource_id": 85,
          "text": "He frowned and turned away"
        },
        {
          "id": 1550196,
          "resource_id": 831,
          "text": "[The prophet] Tursh-rooh (frowned) hua aur berukhi barti"
        }
      ]
    },
    {
      "id": 5760,
      "verse_number": 2,
      "verse_key": "80:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407463,
          "resource_id": 85,
          "text": "when the blind man came to him––"
        },
        {
          "id": 1550197,
          "resource_id": 831,
          "text": "Is baat par ke woh andha us ke paas aa gaya"
        }
      ]
    },
    {
      "id": 5761,
      "verse_number": 3,
      "verse_key": "80:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407464,
          "resource_id": 85,
          "text": "for all you know, he might have grown in spirit,"
        },
        {
          "id": 1550198,
          "resource_id": 831,
          "text": "Tumhe kya khabar, shayad woh sudhar jaye"
        }
      ]
    },
    {
      "id": 5762,
      "verse_number": 4,
      "verse_key": "80:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407465,
          "resource_id": 85,
          "text": "or taken note of something useful to him."
        },
        {
          "id": 1550199,
          "resource_id": 831,
          "text": "ya naseehat par dhyaan de aur naseeat karna us ke liye nafea(faiydamand) ho"
        }
      ]
    },
    {
      "id": 5763,
      "verse_number": 5,
      "verse_key": "80:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407466,
          "resource_id": 85,
          "text": "For the self-satisfied one"
        },
        {
          "id": 1550200,
          "resource_id": 831,
          "text": "Jo shaks be-parwahi baratta hai"
        }
      ]
    },
    {
      "id": 5764,
      "verse_number": 6,
      "verse_key": "80:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407467,
          "resource_id": 85,
          "text": "you go out of your way––"
        },
        {
          "id": 1550201,
          "resource_id": 831,
          "text": "Uski taraf to tum tawajjuh karte ho"
        }
      ]
    },
    {
      "id": 5765,
      "verse_number": 7,
      "verse_key": "80:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407468,
          "resource_id": 85,
          "text": "though you are not to be blamed for his lack of spiritual growth––"
        },
        {
          "id": 1550202,
          "resource_id": 831,
          "text": "Halaanke agar wo na sudhrey to tum par uski kya zimmedari hai"
        }
      ]
    },
    {
      "id": 5766,
      "verse_number": 8,
      "verse_key": "80:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407469,
          "resource_id": 85,
          "text": "but from the one who has come to you full of eagerness"
        },
        {
          "id": 1550203,
          "resource_id": 831,
          "text": "Aur jo khud tumharey paas dauda aata hai"
        }
      ]
    },
    {
      "id": 5767,
      "verse_number": 9,
      "verse_key": "80:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهُوَ يَخْشَىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407470,
          "resource_id": 85,
          "text": "and awe"
        },
        {
          "id": 1550204,
          "resource_id": 831,
          "text": "Aur woh darr raha hota hai"
        }
      ]
    },
    {
      "id": 5768,
      "verse_number": 10,
      "verse_key": "80:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407471,
          "resource_id": 85,
          "text": "you allow yourself to be distracted."
        },
        {
          "id": 1550205,
          "resource_id": 831,
          "text": "Usse tum berukhi barat-tey ho"
        }
      ]
    },
    {
      "id": 5769,
      "verse_number": 11,
      "verse_key": "80:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407472,
          "resource_id": 85,
          "text": "No indeed! This [Quran] is a lesson"
        },
        {
          "id": 1550206,
          "resource_id": 831,
          "text": "Hargiz nahin yeh to ek naseehat hai"
        }
      ]
    },
    {
      "id": 5770,
      "verse_number": 12,
      "verse_key": "80:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407473,
          "resource_id": 85,
          "text": "from which those who wish to be taught should learn,"
        },
        {
          "id": 1550207,
          "resource_id": 831,
          "text": "jiska jee chahey isey qabool karey"
        }
      ]
    },
    {
      "id": 5771,
      "verse_number": 13,
      "verse_key": "80:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى صُحُفٍ مُّكَرَّمَةٍ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407474,
          "resource_id": 85,
          "text": "[written] on honoured,"
        },
        {
          "id": 1550208,
          "resource_id": 831,
          "text": "Yeh aisey saheefon mein darj hai jo mukarram hain"
        }
      ]
    },
    {
      "id": 5772,
      "verse_number": 14,
      "verse_key": "80:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407475,
          "resource_id": 85,
          "text": "exalted, pure pages,"
        },
        {
          "id": 1550209,
          "resource_id": 831,
          "text": "Buland martaba hain, pakeeza hain"
        }
      ]
    },
    {
      "id": 5773,
      "verse_number": 15,
      "verse_key": "80:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بِأَيْدِى سَفَرَةٍ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407476,
          "resource_id": 85,
          "text": "by the hands of"
        },
        {
          "id": 1550210,
          "resource_id": 831,
          "text": "muazzaz aur neik kaatibon ke"
        }
      ]
    },
    {
      "id": 5774,
      "verse_number": 16,
      "verse_key": "80:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كِرَامٍۭ بَرَرَةٍ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407477,
          "resource_id": 85,
          "text": "noble and virtuous scribes."
        },
        {
          "id": 1550211,
          "resource_id": 831,
          "text": "haathon mein rehete hain"
        }
      ]
    },
    {
      "id": 5775,
      "verse_number": 17,
      "verse_key": "80:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407478,
          "resource_id": 85,
          "text": "Woe to man! How ungrateful he is!"
        },
        {
          "id": 1550212,
          "resource_id": 831,
          "text": "Laanat ho Insan par kaisa sakht munkir-e-haq (denies the Truth) hai yeh"
        }
      ]
    },
    {
      "id": 5776,
      "verse_number": 18,
      "verse_key": "80:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407479,
          "resource_id": 85,
          "text": "From what thing does God create him?"
        },
        {
          "id": 1550213,
          "resource_id": 831,
          "text": "Kis cheez se Allah ne isey paida kiya hai"
        }
      ]
    },
    {
      "id": 5777,
      "verse_number": 19,
      "verse_key": "80:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407480,
          "resource_id": 85,
          "text": "He creates him from a droplet, He proportions him,"
        },
        {
          "id": 1550214,
          "resource_id": 831,
          "text": "Nutfa ki ek boondh se Allah ne isey paida kiya phir iski taqdeer muqarrar ki"
        }
      ]
    },
    {
      "id": 5778,
      "verse_number": 20,
      "verse_key": "80:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407481,
          "resource_id": 85,
          "text": "He makes the way easy for him,"
        },
        {
          "id": 1550215,
          "resource_id": 831,
          "text": "Phir iske liye zindagi ki raah aasan ki"
        }
      ]
    },
    {
      "id": 5779,
      "verse_number": 21,
      "verse_key": "80:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407482,
          "resource_id": 85,
          "text": "then He causes him to die and be buried."
        },
        {
          "id": 1550216,
          "resource_id": 831,
          "text": "Phir isey maut di aur qabr mei pahunchaya"
        }
      ]
    },
    {
      "id": 5780,
      "verse_number": 22,
      "verse_key": "80:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407483,
          "resource_id": 85,
          "text": "When He wills, He will raise him up again."
        },
        {
          "id": 1550217,
          "resource_id": 831,
          "text": "Phir jab chahey woh isey dobara utha khada karey"
        }
      ]
    },
    {
      "id": 5781,
      "verse_number": 23,
      "verse_key": "80:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407484,
          "resource_id": 85,
          "text": "Yet man does not fulfil God’s commands."
        },
        {
          "id": 1550218,
          "resource_id": 831,
          "text": "Hargiz nahi, isney woh farz ada nahi kiya jiska Allah ne isey hukum diya tha"
        }
      ]
    },
    {
      "id": 5782,
      "verse_number": 24,
      "verse_key": "80:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407485,
          "resource_id": 85,
          "text": "Let man consider the food he eats!"
        },
        {
          "id": 1550219,
          "resource_id": 831,
          "text": "Phir zara insaan apni khuraak(khane/food) ko dekhe"
        }
      ]
    },
    {
      "id": 5783,
      "verse_number": 25,
      "verse_key": "80:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407486,
          "resource_id": 85,
          "text": "We pour down abundant water"
        },
        {
          "id": 1550220,
          "resource_id": 831,
          "text": "Humne khoob paani lundhaya(poured)"
        }
      ]
    },
    {
      "id": 5784,
      "verse_number": 26,
      "verse_key": "80:26",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407487,
          "resource_id": 85,
          "text": "and cause the soil to split open."
        },
        {
          "id": 1550221,
          "resource_id": 831,
          "text": "Phir zameen ko ajeeb tarah phada"
        }
      ]
    },
    {
      "id": 5785,
      "verse_number": 27,
      "verse_key": "80:27",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407488,
          "resource_id": 85,
          "text": "We make grain grow,"
        },
        {
          "id": 1550222,
          "resource_id": 831,
          "text": "phir us ke andar ugaye galley(grain)"
        }
      ]
    },
    {
      "id": 5786,
      "verse_number": 28,
      "verse_key": "80:28",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَعِنَبًا وَقَضْبًا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407489,
          "resource_id": 85,
          "text": "and vines, fresh vegetation,"
        },
        {
          "id": 1550223,
          "resource_id": 831,
          "text": "Aur angoor aur tarkariyan"
        }
      ]
    },
    {
      "id": 5787,
      "verse_number": 29,
      "verse_key": "80:29",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَزَيْتُونًا وَنَخْلًا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407490,
          "resource_id": 85,
          "text": "olive trees, date palms,"
        },
        {
          "id": 1550224,
          "resource_id": 831,
          "text": "Aur zaitoon aur khajoorein"
        }
      ]
    },
    {
      "id": 5788,
      "verse_number": 30,
      "verse_key": "80:30",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَحَدَآئِقَ غُلْبًا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407491,
          "resource_id": 85,
          "text": "luscious gardens,"
        },
        {
          "id": 1550225,
          "resource_id": 831,
          "text": "Aur ghaney baagh(orchards)"
        }
      ]
    },
    {
      "id": 5789,
      "verse_number": 31,
      "verse_key": "80:31",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفَـٰكِهَةً وَأَبًّا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407492,
          "resource_id": 85,
          "text": "fruits, and fodder:"
        },
        {
          "id": 1550226,
          "resource_id": 831,
          "text": "Aur tarah tarah ke phal aur chaarey"
        }
      ]
    },
    {
      "id": 5790,
      "verse_number": 32,
      "verse_key": "80:32",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407493,
          "resource_id": 85,
          "text": "all for you and your livestock to enjoy."
        },
        {
          "id": 1550227,
          "resource_id": 831,
          "text": "Tumharey liye aur tumharey maweshion(cattles) ke liye saman-e-zeist(provision )ke taur par"
        }
      ]
    },
    {
      "id": 5791,
      "verse_number": 33,
      "verse_key": "80:33",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407494,
          "resource_id": 85,
          "text": "When the Deafening Blast comes––"
        },
        {
          "id": 1550228,
          "resource_id": 831,
          "text": "Aakhir-e-kaar jab woh kaan behrey kar deney wali aawaz buland hogi"
        }
      ]
    },
    {
      "id": 5792,
      "verse_number": 34,
      "verse_key": "80:34",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407495,
          "resource_id": 85,
          "text": "the Day man will flee from his own brother,"
        },
        {
          "id": 1550229,
          "resource_id": 831,
          "text": "Us roz aadmi apne bhai"
        }
      ]
    },
    {
      "id": 5793,
      "verse_number": 35,
      "verse_key": "80:35",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأُمِّهِۦ وَأَبِيهِ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407496,
          "resource_id": 85,
          "text": "his mother, his father,"
        },
        {
          "id": 1550230,
          "resource_id": 831,
          "text": "Aur apni maa aur apne baap"
        }
      ]
    },
    {
      "id": 5794,
      "verse_number": 36,
      "verse_key": "80:36",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407497,
          "resource_id": 85,
          "text": "his wife, his children:"
        },
        {
          "id": 1550231,
          "resource_id": 831,
          "text": "Aur apni biwi aur apni aulad se bhagega"
        }
      ]
    },
    {
      "id": 5795,
      "verse_number": 37,
      "verse_key": "80:37",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407498,
          "resource_id": 85,
          "text": "each of them will be absorbed in concerns of their own on that Day-"
        },
        {
          "id": 1550232,
          "resource_id": 831,
          "text": "Unmein har shaks par us din aisa waqt aa padega ke usay apne siwa kisi ka hosh na hoga"
        }
      ]
    },
    {
      "id": 5796,
      "verse_number": 38,
      "verse_key": "80:38",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407499,
          "resource_id": 85,
          "text": "on that Day some faces will be beaming,"
        },
        {
          "id": 1550233,
          "resource_id": 831,
          "text": "Kuch chehrey us roz damak rahe hongey"
        }
      ]
    },
    {
      "id": 5797,
      "verse_number": 39,
      "verse_key": "80:39",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407500,
          "resource_id": 85,
          "text": "laughing, and rejoicing,"
        },
        {
          "id": 1550234,
          "resource_id": 831,
          "text": "Hashash bashash aur khush o khurram hongey"
        }
      ]
    },
    {
      "id": 5798,
      "verse_number": 40,
      "verse_key": "80:40",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407501,
          "resource_id": 85,
          "text": "but some faces will be dust-stained"
        },
        {
          "id": 1550235,
          "resource_id": 831,
          "text": "Aur kuch chehron par uss roz khaak(dust) udd rahi hogi"
        }
      ]
    },
    {
      "id": 5799,
      "verse_number": 41,
      "verse_key": "80:41",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَرْهَقُهَا قَتَرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407502,
          "resource_id": 85,
          "text": "and covered in darkness:"
        },
        {
          "id": 1550236,
          "resource_id": 831,
          "text": "Aur kalons(darkness) chayi hui hogi"
        }
      ]
    },
    {
      "id": 5800,
      "verse_number": 42,
      "verse_key": "80:42",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407503,
          "resource_id": 85,
          "text": "those are the disbelievers, the licentious."
        },
        {
          "id": 1550237,
          "resource_id": 831,
          "text": "Yahi kafir o fajir (unbelivers and wicked) log hain"
        }
      ]
    }
  ]
}