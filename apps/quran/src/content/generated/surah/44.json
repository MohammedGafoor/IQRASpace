    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Smoke"
    }
  },
  "verses": [
    {
      "id": 4415,
      "verse_number": 1,
      "verse_key": "44:1",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": " حمٓ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406118,
          "resource_id": 85,
          "text": "Ha Mim"
        }
      ]
    },
    {
      "id": 4416,
      "verse_number": 2,
      "verse_key": "44:2",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْكِتَـٰبِ ٱلْمُبِينِ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406119,
          "resource_id": 85,
          "text": "By the Scripture that makes things clear,"
        }
      ]
    },
    {
      "id": 4417,
      "verse_number": 3,
      "verse_key": "44:3",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّآ أَنزَلْنَـٰهُ فِى لَيْلَةٍ مُّبَـٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406120,
          "resource_id": 85,
          "text": "truly We sent it down on a blessed night––We have always sent warnings––"
        }
      ]
    },
    {
      "id": 4418,
      "verse_number": 4,
      "verse_key": "44:4",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406121,
          "resource_id": 85,
          "text": "a night when every matter of wisdom was made distinct"
        }
      ]
    },
    {
      "id": 4419,
      "verse_number": 5,
      "verse_key": "44:5",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَمْرًا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406122,
          "resource_id": 85,
          "text": "at Our command––We have always sent messages to man––"
        }
      ]
    },
    {
      "id": 4420,
      "verse_number": 6,
      "verse_key": "44:6",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "رَحْمَةً مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406123,
          "resource_id": 85,
          "text": "as a mercy [Prophet] from your Lord who sees and knows all,"
        }
      ]
    },
    {
      "id": 4421,
      "verse_number": 7,
      "verse_key": "44:7",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "رَبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406124,
          "resource_id": 85,
          "text": "Lord of the heavens and the earth and everything between––if only you people were firm believers––"
        }
      ]
    },
    {
      "id": 4422,
      "verse_number": 8,
      "verse_key": "44:8",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "لَآ إِلَـٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406125,
          "resource_id": 85,
          "text": "there is no god but Him: He gives life and death––He is your Lord and the Lord of your forefathers––"
        }
      ]
    },
    {
      "id": 4423,
      "verse_number": 9,
      "verse_key": "44:9",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "بَلْ هُمْ فِى شَكٍّ يَلْعَبُونَ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406126,
          "resource_id": 85,
          "text": "yet in [their state of] doubt they take nothing seriously."
        }
      ]
    },
    {
      "id": 4424,
      "verse_number": 10,
      "verse_key": "44:10",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍ مُّبِينٍ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406127,
          "resource_id": 85,
          "text": "[Prophet], watch out for the Day when the sky brings forth clouds of smoke for all to see."
        }
      ]
    },
    {
      "id": 4425,
      "verse_number": 11,
      "verse_key": "44:11",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَغْشَى ٱلنَّاسَ ۖ هَـٰذَا عَذَابٌ أَلِيمٌ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406128,
          "resource_id": 85,
          "text": "It will envelop the people. They will cry, ‘This is a terrible torment!"
        }
      ]
    },
    {
      "id": 4426,
      "verse_number": 12,
      "verse_key": "44:12",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406129,
          "resource_id": 85,
          "text": "Lord relieve us from this torment! We believe!’"
        }
      ]
    },
    {
      "id": 4427,
      "verse_number": 13,
      "verse_key": "44:13",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌ مُّبِينٌ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406130,
          "resource_id": 85,
          "text": "How will this [sudden] faith benefit them? When a prophet came to warn them plainly,"
        }
      ]
    },
    {
      "id": 4428,
      "verse_number": 14,
      "verse_key": "44:14",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌ مَّجْنُونٌ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406131,
          "resource_id": 85,
          "text": "they turned their backs on him, saying, ‘He is tutored! He is possessed!’"
        }
      ]
    },
    {
      "id": 4429,
      "verse_number": 15,
      "verse_key": "44:15",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406132,
          "resource_id": 85,
          "text": "We shall hold the torment back for a while ––you are sure to return [to Us]––"
        }
      ]
    },
    {
      "id": 4430,
      "verse_number": 16,
      "verse_key": "44:16",
      "hizb_number": 50,
      "rub_el_hizb_number": 198,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406133,
          "resource_id": 85,
          "text": "and on the Day We seize [them] mightily We shall exact retribution."
        }
      ]
    },
    {
      "id": 4431,
      "verse_number": 17,
      "verse_key": "44:17",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "۞ وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌ كَرِيمٌ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406134,
          "resource_id": 85,
          "text": "We tested the people of Pharaoh before them: a noble messenger was sent to them,"
        }
      ]
    },
    {
      "id": 4432,
      "verse_number": 18,
      "verse_key": "44:18",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
      "page_number": 496,
      "juz_number": 25,
      "translations": [
        {
          "id": 406135,
          "resource_id": 85,
          "text": "saying, ‘Hand the servants of God over to me! I am a faithful messenger who has been sent to you."
        }
      ]
    },
    {
      "id": 4433,
      "verse_number": 19,
      "verse_key": "44:19",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَـٰنٍ مُّبِينٍ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406136,
          "resource_id": 85,
          "text": "Do not consider yourselves to be above God! I come to you with clear authority."
        }
      ]
    },
    {
      "id": 4434,
      "verse_number": 20,
      "verse_key": "44:20",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406137,
          "resource_id": 85,
          "text": "I seek refuge in my Lord and yours against your insults!"
        }
      ]
    },
    {
      "id": 4435,
      "verse_number": 21,
      "verse_key": "44:21",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَإِن لَّمْ تُؤْمِنُوا۟ لِى فَٱعْتَزِلُونِ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406138,
          "resource_id": 85,
          "text": "If you do not believe me, just let me be.’"
        }
      ]
    },
    {
      "id": 4436,
      "verse_number": 22,
      "verse_key": "44:22",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَدَعَا رَبَّهُۥٓ أَنَّ هَـٰٓؤُلَآءِ قَوْمٌ مُّجْرِمُونَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406139,
          "resource_id": 85,
          "text": "[Moses] cried to his Lord, ‘These people are evildoers!’"
        }
      ]
    },
    {
      "id": 4437,
      "verse_number": 23,
      "verse_key": "44:23",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَأَسْرِ بِعِبَادِى لَيْلًا إِنَّكُم مُّتَّبَعُونَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406140,
          "resource_id": 85,
          "text": "[God replied], ‘Escape in the night with My servants, for you are sure to be pursued."
        }
      ]
    },
    {
      "id": 4438,
      "verse_number": 24,
      "verse_key": "44:24",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَٱتْرُكِ ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ جُندٌ مُّغْرَقُونَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406141,
          "resource_id": 85,
          "text": "Leave the sea behind you parted and their army will be drowned.’"
        }
      ]
    },
    {
      "id": 4439,
      "verse_number": 25,
      "verse_key": "44:25",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "كَمْ تَرَكُوا۟ مِن جَنَّـٰتٍ وَعُيُونٍ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406142,
          "resource_id": 85,
          "text": "Many a garden and spring they left behind,"
        }
      ]
    },
    {
      "id": 4440,
      "verse_number": 26,
      "verse_key": "44:26",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406143,
          "resource_id": 85,
          "text": "many a cornfield and noble building,"
        }
      ]
    },
    {
      "id": 4441,
      "verse_number": 27,
      "verse_key": "44:27",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَنَعْمَةٍ كَانُوا۟ فِيهَا فَـٰكِهِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406144,
          "resource_id": 85,
          "text": "many a thing in which they had delighted:"
        }
      ]
    },
    {
      "id": 4442,
      "verse_number": 28,
      "verse_key": "44:28",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "كَذَٰلِكَ ۖ وَأَوْرَثْنَـٰهَا قَوْمًا ءَاخَرِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406145,
          "resource_id": 85,
          "text": "We gave these to another people to inherit."
        }
      ]
    },
    {
      "id": 4443,
      "verse_number": 29,
      "verse_key": "44:29",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 433,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406146,
          "resource_id": 85,
          "text": "Neither heavens nor earth shed a tear for them, nor were they given any time."
        }
      ]
    },
    {
      "id": 4444,
      "verse_number": 30,
      "verse_key": "44:30",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ نَجَّيْنَا بَنِىٓ إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ ٱلْمُهِينِ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406147,
          "resource_id": 85,
          "text": "We saved the Children of Israel from their degrading suffering"
        }
      ]
    },
    {
      "id": 4445,
      "verse_number": 31,
      "verse_key": "44:31",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "مِن فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ عَالِيًا مِّنَ ٱلْمُسْرِفِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406148,
          "resource_id": 85,
          "text": "at the hands of Pharaoh: he was a tyrant who exceeded all bounds."
        }
      ]
    },
    {
      "id": 4446,
      "verse_number": 32,
      "verse_key": "44:32",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدِ ٱخْتَرْنَـٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَـٰلَمِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406149,
          "resource_id": 85,
          "text": "We chose them knowingly above others:"
        }
      ]
    },
    {
      "id": 4447,
      "verse_number": 33,
      "verse_key": "44:33",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَءَاتَيْنَـٰهُم مِّنَ ٱلْـَٔايَـٰتِ مَا فِيهِ بَلَـٰٓؤٌا۟ مُّبِينٌ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406150,
          "resource_id": 85,
          "text": "We gave them revelations in which there was a clear test."
        }
      ]
    },
    {
      "id": 4448,
      "verse_number": 34,
      "verse_key": "44:34",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ هَـٰٓؤُلَآءِ لَيَقُولُونَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406151,
          "resource_id": 85,
          "text": "These people here assert,"
        }
      ]
    },
    {
      "id": 4449,
      "verse_number": 35,
      "verse_key": "44:35",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنْ هِىَ إِلَّا مَوْتَتُنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406152,
          "resource_id": 85,
          "text": "‘There is nothing beyond our one death: we will not be resurrected."
        }
      ]
    },
    {
      "id": 4450,
      "verse_number": 36,
      "verse_key": "44:36",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَأْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَـٰدِقِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406153,
          "resource_id": 85,
          "text": "Bring back our forefathers, if what you say is true.’"
        }
      ]
    },
    {
      "id": 4451,
      "verse_number": 37,
      "verse_key": "44:37",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍ وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ أَهْلَكْنَـٰهُمْ ۖ إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406154,
          "resource_id": 85,
          "text": "Are they better than the people of Tubba and those who flourished before them? We destroyed them all- they were guilty."
        }
      ]
    },
    {
      "id": 4452,
      "verse_number": 38,
      "verse_key": "44:38",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَـٰعِبِينَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406155,
          "resource_id": 85,
          "text": "We were not playing a pointless game when We created the heavens and earth and everything in between;"
        }
      ]
    },
    {
      "id": 4453,
      "verse_number": 39,
      "verse_key": "44:39",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "مَا خَلَقْنَـٰهُمَآ إِلَّا بِٱلْحَقِّ وَلَـٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ",
      "page_number": 497,
      "juz_number": 25,
      "translations": [
        {
          "id": 406156,
          "resource_id": 85,
          "text": "We created them for a true purpose, but most people do not comprehend."
        }
      ]
    },
    {
      "id": 4454,
      "verse_number": 40,
      "verse_key": "44:40",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَـٰتُهُمْ أَجْمَعِينَ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406157,
          "resource_id": 85,
          "text": "The Day of Decision is the time appointed for all;"
        }
      ]
    },
    {
      "id": 4455,
      "verse_number": 41,
      "verse_key": "44:41",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًى شَيْـًٔا وَلَا هُمْ يُنصَرُونَ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406158,
          "resource_id": 85,
          "text": "a Day when no friend can take another’s place."
        }
      ]
    },
    {
      "id": 4456,
      "verse_number": 42,
      "verse_key": "44:42",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 434,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406159,
          "resource_id": 85,
          "text": "No one will receive any help except for those to whom God shows mercy: He is the Mighty, the Merciful Lord."
        }
      ]
    },
    {
      "id": 4457,
      "verse_number": 43,
      "verse_key": "44:43",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ شَجَرَتَ ٱلزَّقُّومِ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406160,
          "resource_id": 85,
          "text": "The tree of Zaqqum"
        }
      ]
    },
    {
      "id": 4458,
      "verse_number": 44,
      "verse_key": "44:44",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "طَعَامُ ٱلْأَثِيمِ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406161,
          "resource_id": 85,
          "text": "will be food for the sinners:"
        }
      ]
    },
    {
      "id": 4459,
      "verse_number": 45,
      "verse_key": "44:45",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406162,
          "resource_id": 85,
          "text": "[hot] as molten metal, it boils in their bellies"
        }
      ]
    },
    {
      "id": 4460,
      "verse_number": 46,
      "verse_key": "44:46",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "كَغَلْىِ ٱلْحَمِيمِ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406163,
          "resource_id": 85,
          "text": "like seething water."
        }
      ]
    },
    {
      "id": 4461,
      "verse_number": 47,
      "verse_key": "44:47",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406164,
          "resource_id": 85,
          "text": "‘Take him! Thrust him into the depths of Hell!"
        }
      ]
    },
    {
      "id": 4462,
      "verse_number": 48,
      "verse_key": "44:48",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406165,
          "resource_id": 85,
          "text": "Pour scalding water over his head as punishment!’"
        }
      ]
    },
    {
      "id": 4463,
      "verse_number": 49,
      "verse_key": "44:49",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406166,
          "resource_id": 85,
          "text": "‘Taste this, you powerful, respected man!"
        }
      ]
    },
    {
      "id": 4464,
      "verse_number": 50,
      "verse_key": "44:50",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ هَـٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406167,
          "resource_id": 85,
          "text": "This is what you doubted.’"
        }
      ]
    },
    {
      "id": 4465,
      "verse_number": 51,
      "verse_key": "44:51",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406168,
          "resource_id": 85,
          "text": "But those mindful of God will be in a safe place"
        }
      ]
    },
    {
      "id": 4466,
      "verse_number": 52,
      "verse_key": "44:52",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فِى جَنَّـٰتٍ وَعُيُونٍ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406169,
          "resource_id": 85,
          "text": "amid Gardens and springs,"
        }
      ]
    },
    {
      "id": 4467,
      "verse_number": 53,
      "verse_key": "44:53",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَـٰبِلِينَ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406170,
          "resource_id": 85,
          "text": "clothed in silk and fine brocade, facing one another:"
        }
      ]
    },
    {
      "id": 4468,
      "verse_number": 54,
      "verse_key": "44:54",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "كَذَٰلِكَ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406171,
          "resource_id": 85,
          "text": "so it will be. We shall wed them to maidens with large, dark eyes."
        }
      ]
    },
    {
      "id": 4469,
      "verse_number": 55,
      "verse_key": "44:55",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "يَدْعُونَ فِيهَا بِكُلِّ فَـٰكِهَةٍ ءَامِنِينَ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406172,
          "resource_id": 85,
          "text": "Secure and contented, they will call for every kind of fruit."
        }
      ]
    },
    {
      "id": 4470,
      "verse_number": 56,
      "verse_key": "44:56",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406173,
          "resource_id": 85,
          "text": "After the one death they will taste death no more. God will guard them from the torment of Hell,"
        }
      ]
    },
    {
      "id": 4471,
      "verse_number": 57,
      "verse_key": "44:57",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَضْلًا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406174,
          "resource_id": 85,
          "text": "a bounty from your Lord. That is the supreme triumph."
        }
      ]
    },
    {
      "id": 4472,
      "verse_number": 58,
      "verse_key": "44:58",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406175,
          "resource_id": 85,
          "text": "We have made this Quran easy to understand- in your own language [Prophet]- so that they may take heed."
        }
      ]
    },
    {
      "id": 4473,
      "verse_number": 59,
      "verse_key": "44:59",
      "hizb_number": 50,
      "rub_el_hizb_number": 199,
      "ruku_number": 435,
      "manzil_number": 6,
      "sajdah_number": null,
      "text_uthmani": "فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ",
      "page_number": 498,
      "juz_number": 25,
      "translations": [
        {
          "id": 406176,
          "resource_id": 85,
          "text": "So wait; the disbelievers too are waiting."
        }
      ]
    }
  ]
}