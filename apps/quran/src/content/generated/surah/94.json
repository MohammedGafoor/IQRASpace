  "verses": [
    {
      "id": 6091,
      "verse_number": 1,
      "verse_key": "94:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 538,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407794,
          "resource_id": 85,
          "text": "Did We not relieve your heart for you [Prophet],"
        },
        {
          "id": 1550528,
          "resource_id": 831,
          "text": "(Aey Nabi) kya humne tumhara seena tumhare liye khol nahin diya"
        }
      ]
    },
    {
      "id": 6092,
      "verse_number": 2,
      "verse_key": "94:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 538,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407795,
          "resource_id": 85,
          "text": "and remove the burden"
        },
        {
          "id": 1550529,
          "resource_id": 831,
          "text": "Aur tumpar se woh bhari bojh utar diya"
        }
      ]
    },
    {
      "id": 6093,
      "verse_number": 3,
      "verse_key": "94:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 538,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407796,
          "resource_id": 85,
          "text": "that weighed so heavily on your back,"
        },
        {
          "id": 1550530,
          "resource_id": 831,
          "text": "Jo tumhari qamar todhe daal raha tha"
        }
      ]
    },
    {
      "id": 6094,
      "verse_number": 4,
      "verse_key": "94:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 538,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407797,
          "resource_id": 85,
          "text": "and raise your reputation high?"
        },
        {
          "id": 1550531,
          "resource_id": 831,
          "text": "Aur tumhare khatir tumharey zikr ka awazah buland kar diya"
        }
      ]
    },
    {
      "id": 6095,
      "verse_number": 5,
      "verse_key": "94:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 538,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407798,
          "resource_id": 85,
          "text": "So truly where there is hardship there is also ease;"
        },
        {
          "id": 1550532,
          "resource_id": 831,
          "text": "Pas haqeeqat yeh hai kay tangi kay saat farakhi bhi hai"
        }
      ]
    },
    {
      "id": 6096,
      "verse_number": 6,
      "verse_key": "94:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 538,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407799,
          "resource_id": 85,
          "text": "truly where there is hardship there is also ease."
        },
        {
          "id": 1550533,
          "resource_id": 831,
          "text": "Beshak tangi kay saath farakhi bhi hai"
        }
      ]
    },
    {
      "id": 6097,
      "verse_number": 7,
      "verse_key": "94:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 538,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407800,
          "resource_id": 85,
          "text": "The moment you are freed [of one task] work on,"
        },
        {
          "id": 1550534,
          "resource_id": 831,
          "text": "Lihaza jab tum faarig ho to Ibadat ki mushakkat mei lag jao"
        }
      ]
    },
    {
      "id": 6098,
      "verse_number": 8,
      "verse_key": "94:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 538,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407801,
          "resource_id": 85,
          "text": "and turn to your Lord for everything."
        },
        {
          "id": 1550535,
          "resource_id": 831,
          "text": "Aur apne Rubb ki taraf raagib ho"
        }
      ]
    }
  ]
}