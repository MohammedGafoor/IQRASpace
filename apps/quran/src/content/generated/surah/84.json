{
  "syncedAt": "2026-08-31T09:57:48.408Z",
  "chapter": {
    "id": 84,
    "revelation_place": "makkah",
    "revelation_order": 83,
    "bismillah_pre": true,
    "name_simple": "Al-Inshiqaq",
    "name_complex": "Al-'Inshiqāq",
    "name_arabic": "الإنشقاق",
    "verses_count": 25,
    "pages": [
      589,
      589
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Sundering"
    }
  },
  "verses": [
    {
      "id": 5885,
      "verse_number": 1,
      "verse_key": "84:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407588,
          "resource_id": 85,
          "text": "When the sky is ripped apart,"
        },
        {
          "id": 1550322,
          "resource_id": 831,
          "text": "Jab aasman phatt jayega"
        }
      ]
    },
    {
      "id": 5886,
      "verse_number": 2,
      "verse_key": "84:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407589,
          "resource_id": 85,
          "text": "obeying its Lord as it rightly must,"
        },
        {
          "id": 1550323,
          "resource_id": 831,
          "text": "Aur apne Rubb kay famaan ki tameel karega aur uske liye haq yahi hai (ke apne Rubb ka hukum maney)"
        }
      ]
    },
    {
      "id": 5887,
      "verse_number": 3,
      "verse_key": "84:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407590,
          "resource_id": 85,
          "text": "when the earth is levelled out,"
        },
        {
          "id": 1550324,
          "resource_id": 831,
          "text": "Aur jab zameen phaila di jayegi"
        }
      ]
    },
    {
      "id": 5888,
      "verse_number": 4,
      "verse_key": "84:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407591,
          "resource_id": 85,
          "text": "casts out its contents, and becomes empty,"
        },
        {
          "id": 1550325,
          "resource_id": 831,
          "text": "Aur jo kuch uske andar hai usey bahar phenk kar khaali ho jayegi"
        }
      ]
    },
    {
      "id": 5889,
      "verse_number": 5,
      "verse_key": "84:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407592,
          "resource_id": 85,
          "text": "obeying its Lord as it rightly must,"
        },
        {
          "id": 1550326,
          "resource_id": 831,
          "text": "Aur apne Rubb ke hukum ki tameel karegi aur uske liye haq yahi hai (kay uski tameel karey)"
        }
      ]
    },
    {
      "id": 5890,
      "verse_number": 6,
      "verse_key": "84:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407593,
          "resource_id": 85,
          "text": "you humans, toiling laboriously towards your Lord, will meet Him:"
        },
        {
          "id": 1550327,
          "resource_id": 831,
          "text": "Aey insaan tu kashaan kashaan apne Rubb ki taraf chala ja raha hai(striving unto your Lord) aur ussey milney wala hai"
        }
      ]
    },
    {
      "id": 5891,
      "verse_number": 7,
      "verse_key": "84:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407594,
          "resource_id": 85,
          "text": "whoever is given his record in his right hand"
        },
        {
          "id": 1550328,
          "resource_id": 831,
          "text": "Phir jiska naam-e-aamal uske seedhey haath mei diya gaya"
        }
      ]
    },
    {
      "id": 5892,
      "verse_number": 8,
      "verse_key": "84:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407595,
          "resource_id": 85,
          "text": "will have an easy reckoning"
        },
        {
          "id": 1550329,
          "resource_id": 831,
          "text": "Ussey halka hisaab liya jayega"
        }
      ]
    },
    {
      "id": 5893,
      "verse_number": 9,
      "verse_key": "84:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407596,
          "resource_id": 85,
          "text": "and return to his people well pleased,"
        },
        {
          "id": 1550330,
          "resource_id": 831,
          "text": "Aur woh apne logon ki taraf khush khush paltega"
        }
      ]
    },
    {
      "id": 5894,
      "verse_number": 10,
      "verse_key": "84:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407597,
          "resource_id": 85,
          "text": "but whoever is given his record from behind his back"
        },
        {
          "id": 1550331,
          "resource_id": 831,
          "text": "Raha woh shaks jiska naam-e-aamal us ki peeth ke pichey diya jayega"
        }
      ]
    },
    {
      "id": 5895,
      "verse_number": 11,
      "verse_key": "84:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407598,
          "resource_id": 85,
          "text": "will cry out for destruction––"
        },
        {
          "id": 1550332,
          "resource_id": 831,
          "text": "To woh maut ko pukarega"
        }
      ]
    },
    {
      "id": 5896,
      "verse_number": 12,
      "verse_key": "84:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَصْلَىٰ سَعِيرًا",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407599,
          "resource_id": 85,
          "text": "he will burn in the blazing Fire."
        },
        {
          "id": 1550333,
          "resource_id": 831,
          "text": "Aur bhadakti hui aag mei ja padega"
        }
      ]
    },
    {
      "id": 5897,
      "verse_number": 13,
      "verse_key": "84:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407600,
          "resource_id": 85,
          "text": "He used to live among his people well pleased."
        },
        {
          "id": 1550334,
          "resource_id": 831,
          "text": "Woh apne ghar walon mein magan tha"
        }
      ]
    },
    {
      "id": 5898,
      "verse_number": 14,
      "verse_key": "84:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407601,
          "resource_id": 85,
          "text": "He thought he would never return [to his Lord]––"
        },
        {
          "id": 1550335,
          "resource_id": 831,
          "text": "Usne samjha tha ke usey kabhi palatna nahin hai"
        }
      ]
    },
    {
      "id": 5899,
      "verse_number": 15,
      "verse_key": "84:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407602,
          "resource_id": 85,
          "text": "indeed he will! His Lord was watching him."
        },
        {
          "id": 1550336,
          "resource_id": 831,
          "text": "Palatna kaise na tha, uska Rubb uske kartoot dekh raha tha"
        }
      ]
    },
    {
      "id": 5900,
      "verse_number": 16,
      "verse_key": "84:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407603,
          "resource_id": 85,
          "text": "I swear by the glow of sunset,"
        },
        {
          "id": 1550337,
          "resource_id": 831,
          "text": "Pas nahin mai kasam khata hon shafaq(twilight) ki"
        }
      ]
    },
    {
      "id": 5901,
      "verse_number": 17,
      "verse_key": "84:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ وَمَا وَسَقَ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407604,
          "resource_id": 85,
          "text": "by the night and what it covers,"
        },
        {
          "id": 1550338,
          "resource_id": 831,
          "text": "Aur raat ki aur jo kuch woh sameith leti hai"
        }
      ]
    },
    {
      "id": 5902,
      "verse_number": 18,
      "verse_key": "84:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407605,
          "resource_id": 85,
          "text": "by the full moon,"
        },
        {
          "id": 1550339,
          "resource_id": 831,
          "text": "Aur chaand ki jabke woh maah-e-kaamil (full) ho jata hai"
        }
      ]
    },
    {
      "id": 5903,
      "verse_number": 19,
      "verse_key": "84:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407606,
          "resource_id": 85,
          "text": "you will progress from stage to stage."
        },
        {
          "id": 1550340,
          "resource_id": 831,
          "text": "Tumko zaroor darja ba darja ek haalat se dusri halat ki taraf guzarte chalay jana hai"
        }
      ]
    },
    {
      "id": 5904,
      "verse_number": 20,
      "verse_key": "84:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407607,
          "resource_id": 85,
          "text": "So why do they not believe?"
        },
        {
          "id": 1550341,
          "resource_id": 831,
          "text": "Phir in logon ko kya ho gaya hai ke yeh imaan nahin laatey"
        }
      ]
    },
    {
      "id": 5905,
      "verse_number": 21,
      "verse_key": "84:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": 13,
      "text_uthmani": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407608,
          "resource_id": 85,
          "text": "Why, when the Quran is read to them, do they not prostrate themselves [to God]?"
        },
        {
          "id": 1550342,
          "resource_id": 831,
          "text": "Aur jab Quran inke samney pada jata hai to sajda nahin karte"
        }
      ]
    },
    {
      "id": 5906,
      "verse_number": 22,
      "verse_key": "84:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407609,
          "resource_id": 85,
          "text": "No! The disbelievers reject the Quran––"
        },
        {
          "id": 1550343,
          "resource_id": 831,
          "text": "Balke yeh munkireen to ulta jhutlatay hain"
        }
      ]
    },
    {
      "id": 5907,
      "verse_number": 23,
      "verse_key": "84:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407610,
          "resource_id": 85,
          "text": "God knows best what they keep hidden inside––"
        },
        {
          "id": 1550344,
          "resource_id": 831,
          "text": "Halaanke jo kuch yeh (apne naam-e-aamal mein) jama kar rahey hain Allah usey khoob janta hai"
        }
      ]
    },
    {
      "id": 5908,
      "verse_number": 24,
      "verse_key": "84:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407611,
          "resource_id": 85,
          "text": "so give them news of a painful torment."
        },
        {
          "id": 1550345,
          "resource_id": 831,
          "text": "Lihaza inko dardnaak azaab ki basharat dedo"
        }
      ]
    },
    {
      "id": 5909,
      "verse_number": 25,
      "verse_key": "84:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 528,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407612,
          "resource_id": 85,
          "text": "But those who believe and do good deeds will have a never-ending reward."
        },
        {
          "id": 1550346,
          "resource_id": 831,
          "text": "Albatta jo log imaan le aaye hain aur jinho ne neik aamal kiye hain unke liye kabhi khatam na honay wala ajar hai"
        }
      ]
    }
  ]
}