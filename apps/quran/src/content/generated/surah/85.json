    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Mansions of the Stars"
    }
  },
  "verses": [
    {
      "id": 5910,
      "verse_number": 1,
      "verse_key": "85:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407613,
          "resource_id": 85,
          "text": "By the sky with its towering constellations,"
        }
      ]
    },
    {
      "id": 5911,
      "verse_number": 2,
      "verse_key": "85:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407614,
          "resource_id": 85,
          "text": "by the promised Day,"
        }
      ]
    },
    {
      "id": 5912,
      "verse_number": 3,
      "verse_key": "85:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَشَاهِدٍ وَمَشْهُودٍ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407615,
          "resource_id": 85,
          "text": "by the Witness and that which is witnessed,"
        }
      ]
    },
    {
      "id": 5913,
      "verse_number": 4,
      "verse_key": "85:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407616,
          "resource_id": 85,
          "text": "damned were the makers of the trench,"
        }
      ]
    },
    {
      "id": 5914,
      "verse_number": 5,
      "verse_key": "85:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407617,
          "resource_id": 85,
          "text": "the makers of the fuel-stoked fire!"
        }
      ]
    },
    {
      "id": 5915,
      "verse_number": 6,
      "verse_key": "85:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذْ هُمْ عَلَيْهَا قُعُودٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407618,
          "resource_id": 85,
          "text": "They sat down"
        }
      ]
    },
    {
      "id": 5916,
      "verse_number": 7,
      "verse_key": "85:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407619,
          "resource_id": 85,
          "text": "to watch what they were doing to the believers."
        }
      ]
    },
    {
      "id": 5917,
      "verse_number": 8,
      "verse_key": "85:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407620,
          "resource_id": 85,
          "text": "Their only grievance against them was their faith in God, the Mighty, the Praiseworthy,"
        }
      ]
    },
    {
      "id": 5918,
      "verse_number": 9,
      "verse_key": "85:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407621,
          "resource_id": 85,
          "text": "to whom all control over the heavens and earth belongs: God is witness over all things."
        }
      ]
    },
    {
      "id": 5919,
      "verse_number": 10,
      "verse_key": "85:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407622,
          "resource_id": 85,
          "text": "For those who persecute believing men and women, and do not repent afterwards, there will be the torment of Hell and burning."
        }
      ]
    },
    {
      "id": 5920,
      "verse_number": 11,
      "verse_key": "85:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407623,
          "resource_id": 85,
          "text": "But for those who believe and do good deeds there will be Gardens graced with flowing streams: that is the great triumph."
        }
      ]
    },
    {
      "id": 5921,
      "verse_number": 12,
      "verse_key": "85:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407624,
          "resource_id": 85,
          "text": "[Prophet], your Lord’s punishment is truly stern––"
        }
      ]
    },
    {
      "id": 5922,
      "verse_number": 13,
      "verse_key": "85:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407625,
          "resource_id": 85,
          "text": "it is He who brings people to life, and will restore them to life again––"
        }
      ]
    },
    {
      "id": 5923,
      "verse_number": 14,
      "verse_key": "85:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407626,
          "resource_id": 85,
          "text": "and He is the Most Forgiving, the Most Loving."
        }
      ]
    },
    {
      "id": 5924,
      "verse_number": 15,
      "verse_key": "85:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407627,
          "resource_id": 85,
          "text": "The Glorious Lord of the Throne,"
        }
      ]
    },
    {
      "id": 5925,
      "verse_number": 16,
      "verse_key": "85:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَعَّالٌ لِّمَا يُرِيدُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407628,
          "resource_id": 85,
          "text": "He does whatever He will."
        }
      ]
    },
    {
      "id": 5926,
      "verse_number": 17,
      "verse_key": "85:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407629,
          "resource_id": 85,
          "text": "Have you [not] heard the stories of the forces"
        }
      ]
    },
    {
      "id": 5927,
      "verse_number": 18,
      "verse_key": "85:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِرْعَوْنَ وَثَمُودَ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407630,
          "resource_id": 85,
          "text": "of Pharaoh and Thamud?"
        }
      ]
    },
    {
      "id": 5928,
      "verse_number": 19,
      "verse_key": "85:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407631,
          "resource_id": 85,
          "text": "Yet still the disbelievers persist in denial."
        }
      ]
    },
    {
      "id": 5929,
      "verse_number": 20,
      "verse_key": "85:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407632,
          "resource_id": 85,
          "text": "God surrounds them all."
        }
      ]
    },
    {
      "id": 5930,
      "verse_number": 21,
      "verse_key": "85:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407633,
          "resource_id": 85,
          "text": "This is truly a glorious Quran"
        }
      ]
    },
    {
      "id": 5931,
      "verse_number": 22,
      "verse_key": "85:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى لَوْحٍ مَّحْفُوظٍۭ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407634,
          "resource_id": 85,
          "text": "[written] on a preserved Tablet."
        }
      ]
    }
  ]
}