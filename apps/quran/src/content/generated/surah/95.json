      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَطُورِ سِينِينَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407803,
          "resource_id": 85,
