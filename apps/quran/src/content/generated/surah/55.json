      "verse_key": "55:35",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406639,
          "resource_id": 85,
          "text": "A flash of fire and smoke will be released upon you and no one will come to your aid."
        }
