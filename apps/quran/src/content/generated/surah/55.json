      "verse_number": 34,
      "verse_key": "55:34",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406638,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
