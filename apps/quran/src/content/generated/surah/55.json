      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱلرَّحْمَـٰنُ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406605,
          "resource_id": 85,
          "text": "It is the Lord of Mercy"
        }
      ]
    },
    {
      "id": 4903,
      "verse_number": 2,
      "verse_key": "55:2",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَّمَ ٱلْقُرْءَانَ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406606,
          "resource_id": 85,
          "text": "who taught the Quran."
        }
      ]
    },
    {
      "id": 4904,
      "verse_number": 3,
      "verse_key": "55:3",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406607,
          "resource_id": 85,
          "text": "He created man"
        }
      ]
    },
    {
      "id": 4905,
      "verse_number": 4,
      "verse_key": "55:4",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَّمَهُ ٱلْبَيَانَ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406608,
          "resource_id": 85,
          "text": "and taught him to communicate."
        }
      ]
    },
    {
      "id": 4906,
      "verse_number": 5,
      "verse_key": "55:5",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406609,
          "resource_id": 85,
          "text": "The sun and the moon follow their calculated courses;"
        }
      ]
    },
    {
      "id": 4907,
      "verse_number": 6,
      "verse_key": "55:6",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406610,
          "resource_id": 85,
          "text": "the plants and the trees submit to His designs;"
        }
      ]
    },
    {
      "id": 4908,
      "verse_number": 7,
      "verse_key": "55:7",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406611,
          "resource_id": 85,
          "text": "He has raised up the sky. He has set the balance"
        }
      ]
    },
    {
      "id": 4909,
      "verse_number": 8,
      "verse_key": "55:8",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406612,
          "resource_id": 85,
          "text": "so that you may not exceed in the balance:"
        }
      ]
    },
    {
      "id": 4910,
      "verse_number": 9,
      "verse_key": "55:9",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406613,
          "resource_id": 85,
          "text": "weigh with justice and do not fall short in the balance."
        }
      ]
    },
    {
      "id": 4911,
      "verse_number": 10,
      "verse_key": "55:10",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406614,
          "resource_id": 85,
          "text": "He set down the Earth for His creatures,"
        }
      ]
    },
    {
      "id": 4912,
      "verse_number": 11,
      "verse_key": "55:11",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406615,
          "resource_id": 85,
          "text": "with its fruits, its palm trees with sheathed clusters,"
        }
      ]
    },
    {
      "id": 4913,
      "verse_number": 12,
      "verse_key": "55:12",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406616,
          "resource_id": 85,
          "text": "its husked grain, its fragrant plants."
        }
      ]
    },
    {
      "id": 4914,
      "verse_number": 13,
      "verse_key": "55:13",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406617,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4915,
      "verse_number": 14,
      "verse_key": "55:14",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406618,
          "resource_id": 85,
          "text": "He created mankind out of dried clay, like pottery,"
        }
      ]
    },
    {
      "id": 4916,
      "verse_number": 15,
      "verse_key": "55:15",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406619,
          "resource_id": 85,
          "text": "the jinn out of smokeless fire."
        }
      ]
    },
    {
      "id": 4917,
      "verse_number": 16,
      "verse_key": "55:16",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 531,
      "juz_number": 27,
      "translations": [
        {
          "id": 406620,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4918,
      "verse_number": 17,
      "verse_key": "55:17",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406621,
          "resource_id": 85,
          "text": "He is Lord of the two risings and Lord of the two settings."
        }
      ]
    },
    {
      "id": 4919,
      "verse_number": 18,
      "verse_key": "55:18",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406622,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4920,
      "verse_number": 19,
      "verse_key": "55:19",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406623,
          "resource_id": 85,
          "text": "He released the two bodies of [fresh and salt] water. They meet,"
        }
      ]
    },
    {
      "id": 4921,
      "verse_number": 20,
      "verse_key": "55:20",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406624,
          "resource_id": 85,
          "text": "yet there is a barrier between them they do not cross."
        }
      ]
    },
    {
      "id": 4922,
      "verse_number": 21,
      "verse_key": "55:21",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406625,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4923,
      "verse_number": 22,
      "verse_key": "55:22",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406626,
          "resource_id": 85,
          "text": "Pearls come forth from them: large ones, and small, brilliant ones."
        }
      ]
    },
    {
      "id": 4924,
      "verse_number": 23,
      "verse_key": "55:23",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406627,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4925,
      "verse_number": 24,
      "verse_key": "55:24",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406628,
          "resource_id": 85,
          "text": "His are the moving ships that float, high as mountains, on the sea."
        }
      ]
    },
    {
      "id": 4926,
      "verse_number": 25,
      "verse_key": "55:25",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 468,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406629,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4927,
      "verse_number": 26,
      "verse_key": "55:26",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كُلُّ مَنْ عَلَيْهَا فَانٍ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406630,
          "resource_id": 85,
          "text": "Everyone on earth perishes;"
        }
      ]
    },
    {
      "id": 4928,
      "verse_number": 27,
      "verse_key": "55:27",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406631,
          "resource_id": 85,
          "text": "all that remains is the Face of your Lord, full of majesty, bestowing honour."
        }
      ]
    },
    {
      "id": 4929,
      "verse_number": 28,
      "verse_key": "55:28",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406632,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4930,
      "verse_number": 29,
      "verse_key": "55:29",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406633,
          "resource_id": 85,
          "text": "Everyone in heaven and earth entreats Him; every day He is at work."
        }
      ]
    },
    {
      "id": 4931,
      "verse_number": 30,
      "verse_key": "55:30",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406634,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4932,
      "verse_number": 31,
      "verse_key": "55:31",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406635,
          "resource_id": 85,
          "text": "We shall attend to you two huge armies [of jinn and mankind]."
        }
      ]
    },
    {
      "id": 4933,
      "verse_number": 32,
      "verse_key": "55:32",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406636,
          "resource_id": 85,
          "text": "Which, then, of your Lord’s blessings do you both deny?"
        }
      ]
    },
    {
      "id": 4934,
      "verse_number": 33,
      "verse_key": "55:33",
      "hizb_number": 54,
      "rub_el_hizb_number": 213,
      "ruku_number": 469,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ",
      "page_number": 532,
      "juz_number": 27,
      "translations": [
        {
          "id": 406637,
          "resource_id": 85,
          "text": "Jinn and mankind, if you can pass beyond the regions of heaven and earth, then do so: you will not pass without Our authority."
        }
      ]
    },
