{
  "syncedAt": "2026-08-31T09:57:47.991Z",
  "chapter": {
    "id": 83,
    "revelation_place": "makkah",
    "revelation_order": 86,
    "bismillah_pre": true,
    "name_simple": "Al-Mutaffifin",
    "name_complex": "Al-Muţaffifīn",
    "name_arabic": "المطففين",
    "verses_count": 36,
    "pages": [
      587,
      589
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Defrauding"
    }
  },
  "verses": [
    {
      "id": 5849,
      "verse_number": 1,
      "verse_key": "83:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَيْلٌ لِّلْمُطَفِّفِينَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407552,
          "resource_id": 85,
          "text": "Woe to those who give short measure,"
        },
        {
          "id": 1550286,
          "resource_id": 831,
          "text": "Tabahi hai dandi maarne walon ke liye"
        }
      ]
    },
    {
      "id": 5850,
      "verse_number": 2,
      "verse_key": "83:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407553,
          "resource_id": 85,
          "text": "who demand of other people full measure for themselves,"
        },
        {
          "id": 1550287,
          "resource_id": 831,
          "text": "Jinka haal yeh hai ke jab logon se letey hai to pura pura letey hai"
        }
      ]
    },
    {
      "id": 5851,
      "verse_number": 3,
      "verse_key": "83:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407554,
          "resource_id": 85,
          "text": "but give less than they should when it is they who weigh or measure for others!"
        },
        {
          "id": 1550288,
          "resource_id": 831,
          "text": "Aur jab unko naap kar ya toal kar dete hai to unhein ghata dete hai"
        }
      ]
    },
    {
      "id": 5852,
      "verse_number": 4,
      "verse_key": "83:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407555,
          "resource_id": 85,
          "text": "Do these people not realize that they will be raised up"
        },
        {
          "id": 1550289,
          "resource_id": 831,
          "text": "Kya yeh log nahin samajhte ke ek badey din"
        }
      ]
    },
    {
      "id": 5853,
      "verse_number": 5,
      "verse_key": "83:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِيَوْمٍ عَظِيمٍ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407556,
          "resource_id": 85,
          "text": "on a mighty Day,"
        },
        {
          "id": 1550290,
          "resource_id": 831,
          "text": "Yeh utha kar laaye jaaney waley hain"
        }
      ]
    },
    {
      "id": 5854,
      "verse_number": 6,
      "verse_key": "83:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407557,
          "resource_id": 85,
          "text": "a Day when everyone will stand before the Lord of the Worlds?"
        },
        {
          "id": 1550291,
          "resource_id": 831,
          "text": "Uss din jabke sab log Rabb-ul-Aalamin ke samney khadey hongey"
        }
      ]
    },
    {
      "id": 5855,
      "verse_number": 7,
      "verse_key": "83:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407558,
          "resource_id": 85,
          "text": "No indeed! The list of the wicked is in Sijjin––"
        },
        {
          "id": 1550292,
          "resource_id": 831,
          "text": "Hargiz nahin, yaqeenan badkaaron ka naam-e- aamal qaid-khane ke daftar mei hai"
        }
      ]
    },
    {
      "id": 5856,
      "verse_number": 8,
      "verse_key": "83:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407559,
          "resource_id": 85,
          "text": "what will explain to you what Sijjin is?––"
        },
        {
          "id": 1550293,
          "resource_id": 831,
          "text": "Aur tumhey kya maloom ke woh qaid-khaney ka daftar kya hai"
        }
      ]
    },
    {
      "id": 5857,
      "verse_number": 9,
      "verse_key": "83:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كِتَـٰبٌ مَّرْقُومٌ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407560,
          "resource_id": 85,
          "text": "a clearly numbered list."
        },
        {
          "id": 1550294,
          "resource_id": 831,
          "text": "Ek kitaab hai likhi hui"
        }
      ]
    },
    {
      "id": 5858,
      "verse_number": 10,
      "verse_key": "83:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407561,
          "resource_id": 85,
          "text": "Woe on that day to the deniers,"
        },
        {
          "id": 1550295,
          "resource_id": 831,
          "text": "Tabahi hai us roz jhutlane walon ke liye"
        }
      ]
    },
    {
      "id": 5859,
      "verse_number": 11,
      "verse_key": "83:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407562,
          "resource_id": 85,
          "text": "those who deny the Day of Judgement!"
        },
        {
          "id": 1550296,
          "resource_id": 831,
          "text": "Jo roz-e-jaza ko jhutlatay hain"
        }
      ]
    },
    {
      "id": 5860,
      "verse_number": 12,
      "verse_key": "83:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407563,
          "resource_id": 85,
          "text": "Only the evil aggressor denies it:"
        },
        {
          "id": 1550297,
          "resource_id": 831,
          "text": "Aur usey nahin jhutlata magar har woh shaks jo hadd se guzar janey wala bad-amal hai"
        }
      ]
    },
    {
      "id": 5861,
      "verse_number": 13,
      "verse_key": "83:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407564,
          "resource_id": 85,
          "text": "when Our revelations are recited to him, he says, ‘Ancient fables!’"
        },
        {
          "id": 1550298,
          "resource_id": 831,
          "text": "Usey jab hamari ayaat sunayi jaati hain to kehta hai yeh to agley waqton ki kahaniyan hai"
        }
      ]
    },
    {
      "id": 5862,
      "verse_number": 14,
      "verse_key": "83:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407565,
          "resource_id": 85,
          "text": "No indeed! Their hearts are encrusted with what they have done."
        },
        {
          "id": 1550299,
          "resource_id": 831,
          "text": "Hargiz nahin, balke darasal in logon ke dilon par inke burey aamal ka zang(rust) chadh gaya hai"
        }
      ]
    },
    {
      "id": 5863,
      "verse_number": 15,
      "verse_key": "83:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407566,
          "resource_id": 85,
          "text": "No indeed! On that Day they will be screened off from their Lord,"
        },
        {
          "id": 1550300,
          "resource_id": 831,
          "text": "Hargiz nahin bil yaqeen us roz yeh apne Rubb ki deed(deedar) se mehroom rakhey jayenge"
        }
      ]
    },
    {
      "id": 5864,
      "verse_number": 16,
      "verse_key": "83:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407567,
          "resource_id": 85,
          "text": "they will burn in Hell,"
        },
        {
          "id": 1550301,
          "resource_id": 831,
          "text": "Phir yeh jahannum mein jaa padenge"
        }
      ]
    },
    {
      "id": 5865,
      "verse_number": 17,
      "verse_key": "83:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407568,
          "resource_id": 85,
          "text": "and they will be told, ‘This is what you called a lie.’"
        },
        {
          "id": 1550302,
          "resource_id": 831,
          "text": "Phir insey kaha jayega ke yeh wahi cheez hai jisey tum jhutlaya karte thay"
        }
      ]
    },
    {
      "id": 5866,
      "verse_number": 18,
      "verse_key": "83:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407569,
          "resource_id": 85,
          "text": "No indeed! The list of the truly good is in 'Illiyyin––"
        },
        {
          "id": 1550303,
          "resource_id": 831,
          "text": "Hargiz nahin, beshak neik aadmion ka naam-e-aamal buland paya logon ke daftar mein hai"
        }
      ]
    },
    {
      "id": 5867,
      "verse_number": 19,
      "verse_key": "83:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407570,
          "resource_id": 85,
          "text": "what will explain to you what 'Illiyyin is?––"
        },
        {
          "id": 1550304,
          "resource_id": 831,
          "text": "Aur tumhein kya khabar ke kya hai woh buland paya logon ka daftar"
        }
      ]
    },
    {
      "id": 5868,
      "verse_number": 20,
      "verse_key": "83:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كِتَـٰبٌ مَّرْقُومٌ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407571,
          "resource_id": 85,
          "text": "a clearly written list,"
        },
        {
          "id": 1550305,
          "resource_id": 831,
          "text": "Ek likhi hui kitaab hai"
        }
      ]
    },
    {
      "id": 5869,
      "verse_number": 21,
      "verse_key": "83:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407572,
          "resource_id": 85,
          "text": "witnessed by those brought near."
        },
        {
          "id": 1550306,
          "resource_id": 831,
          "text": "Jiski nigeh-daasht muqarrab farishtay karte hain"
        }
      ]
    },
    {
      "id": 5870,
      "verse_number": 22,
      "verse_key": "83:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407573,
          "resource_id": 85,
          "text": "The truly good will live in bliss,"
        },
        {
          "id": 1550307,
          "resource_id": 831,
          "text": "Beshak neik log badey mazey mein hongey"
        }
      ]
    },
    {
      "id": 5871,
      "verse_number": 23,
      "verse_key": "83:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407574,
          "resource_id": 85,
          "text": "seated on couches, gazing around."
        },
        {
          "id": 1550308,
          "resource_id": 831,
          "text": "Unchi masnadon(couches) par baithay nazarey kar rahey hongey"
        }
      ]
    },
    {
      "id": 5872,
      "verse_number": 24,
      "verse_key": "83:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407575,
          "resource_id": 85,
          "text": "You will recognize on their faces the radiance of bliss."
        },
        {
          "id": 1550309,
          "resource_id": 831,
          "text": "Unke chehron par tum khushhaali ki raunak mehsoos karogey"
        }
      ]
    },
    {
      "id": 5873,
      "verse_number": 25,
      "verse_key": "83:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407576,
          "resource_id": 85,
          "text": "They will be served a sealed nectar,"
        },
        {
          "id": 1550310,
          "resource_id": 831,
          "text": "Unko nafees tareen sarband sharaab pilayi jayegi jispar mushk ki mohar(seal) lagi hogi"
        }
      ]
    },
    {
      "id": 5874,
      "verse_number": 26,
      "verse_key": "83:26",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407577,
          "resource_id": 85,
          "text": "its seal [perfumed with] a fragrant herb––let those who strive, strive for this––"
        },
        {
          "id": 1550311,
          "resource_id": 831,
          "text": "Jo log dusron par baazi le jana chahtey hon woh is cheez ko haasil karne mei baazi le jane ki koshish karein"
        }
      ]
    },
    {
      "id": 5875,
      "verse_number": 27,
      "verse_key": "83:27",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407578,
          "resource_id": 85,
          "text": "mixed with the water of Tasnim,"
        },
        {
          "id": 1550312,
          "resource_id": 831,
          "text": "Us sharaab mei tasneem ki aamezish(mixture) hogi"
        }
      ]
    },
    {
      "id": 5876,
      "verse_number": 28,
      "verse_key": "83:28",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407579,
          "resource_id": 85,
          "text": "a spring from which those brought near will drink."
        },
        {
          "id": 1550313,
          "resource_id": 831,
          "text": "Yeh ek chasma hai jiske paani ke saath muqarrab log sharaab piyengey"
        }
      ]
    },
    {
      "id": 5877,
      "verse_number": 29,
      "verse_key": "83:29",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407580,
          "resource_id": 85,
          "text": "The wicked used to laugh at the believers––"
        },
        {
          "id": 1550314,
          "resource_id": 831,
          "text": "Mujrim log duniya mein imaan laane walon ka mazaak udate thay"
        }
      ]
    },
    {
      "id": 5878,
      "verse_number": 30,
      "verse_key": "83:30",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407581,
          "resource_id": 85,
          "text": "they would wink at one another when the believers passed by them,"
        },
        {
          "id": 1550315,
          "resource_id": 831,
          "text": "Jab unke paas se guzarte to aankhein maar maar kar unki taraf isharey karte thay"
        }
      ]
    },
    {
      "id": 5879,
      "verse_number": 31,
      "verse_key": "83:31",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407582,
          "resource_id": 85,
          "text": "joke about them when they got back to their own people,"
        },
        {
          "id": 1550316,
          "resource_id": 831,
          "text": "Apne gharon ki taraf palat-tey to mazey letey huey palat-tey thay"
        }
      ]
    },
    {
      "id": 5880,
      "verse_number": 32,
      "verse_key": "83:32",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407583,
          "resource_id": 85,
          "text": "and say, when they saw them, ‘These people are misguided,’"
        },
        {
          "id": 1550317,
          "resource_id": 831,
          "text": "Aur jab unhein dekhte to kehte thay ke yeh behke huey log hain"
        }
      ]
    },
    {
      "id": 5881,
      "verse_number": 33,
      "verse_key": "83:33",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَـٰفِظِينَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407584,
          "resource_id": 85,
          "text": "though they were not sent to be their keepers-"
        },
        {
          "id": 1550318,
          "resource_id": 831,
          "text": "Halaanke woh un par nigran banakar nahin bhejey gaye thay"
        }
      ]
    },
    {
      "id": 5882,
      "verse_number": 34,
      "verse_key": "83:34",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ",
      "page_number": 588,
      "juz_number": 30,
      "translations": [
        {
          "id": 407585,
          "resource_id": 85,
          "text": "so today the believers are laughing at the disbelievers"
        },
        {
          "id": 1550319,
          "resource_id": 831,
          "text": "Aaj imaan laane waley kuffar par hans rahay hai"
        }
      ]
    },
    {
      "id": 5883,
      "verse_number": 35,
      "verse_key": "83:35",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407586,
          "resource_id": 85,
          "text": "as they sit on couches, gazing around."
        },
        {
          "id": 1550320,
          "resource_id": 831,
          "text": "Masnadon par baithey huey unka haal dekh rahey hain"
        }
      ]
    },
    {
      "id": 5884,
      "verse_number": 36,
      "verse_key": "83:36",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 527,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ",
      "page_number": 589,
      "juz_number": 30,
      "translations": [
        {
          "id": 407587,
          "resource_id": 85,
          "text": "Have the disbelievers [not] been repaid for their deeds?"
        },
        {
          "id": 1550321,
          "resource_id": 831,
          "text": "Mil gaya na kafiron ko un harkaton ka sawab jo woh kiya karte thay"
        }
      ]
    }
  ]
}