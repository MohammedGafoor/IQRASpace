  "verses": [
    {
      "id": 6198,
      "verse_number": 1,
      "verse_key": "107:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407901,
          "resource_id": 85,
          "text": "[Prophet], have you considered the person who denies the Judgement?"
        },
        {
          "id": 1550635,
          "resource_id": 831,
          "text": "Tum ne dekha us shaks ko jo aakhirat ki jaza va saza ko jhutlata hai"
        }
      ]
    },
    {
      "id": 6199,
      "verse_number": 2,
      "verse_key": "107:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407902,
          "resource_id": 85,
          "text": "It is he who pushes aside the orphan"
        },
        {
          "id": 1550636,
          "resource_id": 831,
          "text": "Wahi to hai jo yateem ko dhakkey deta hai"
        }
      ]
    },
    {
      "id": 6200,
      "verse_number": 3,
      "verse_key": "107:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407903,
          "resource_id": 85,
          "text": "and does not urge others to feed the needy."
        },
        {
          "id": 1550637,
          "resource_id": 831,
          "text": "Aur miskeen ka khana dene par nahin uksata"
        }
      ]
    },
    {
      "id": 6201,
      "verse_number": 4,
      "verse_key": "107:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَوَيْلٌ لِّلْمُصَلِّينَ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407904,
          "resource_id": 85,
          "text": "So woe to those who pray"
        },
        {
          "id": 1550638,
          "resource_id": 831,
          "text": "Phir tabahi hai un namaz padhne walon ke liye"
        }
      ]
    },
    {
      "id": 6202,
      "verse_number": 5,
      "verse_key": "107:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407905,
          "resource_id": 85,
          "text": "but are heedless of their prayer;"
        },
        {
          "id": 1550639,
          "resource_id": 831,
          "text": "Jo apni namaz se gaflat barat-tey hain"
        }
      ]
    },
    {
      "id": 6203,
      "verse_number": 6,
      "verse_key": "107:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407906,
          "resource_id": 85,
          "text": "those who are all show"
        },
        {
          "id": 1550640,
          "resource_id": 831,
          "text": "Jo riya-kaari(dikhawa) karte hai"
        }
      ]
    },
    {
      "id": 6204,
      "verse_number": 7,
      "verse_key": "107:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 551,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407907,
          "resource_id": 85,
          "text": "and forbid common kindnesses."
        },
        {
          "id": 1550641,
          "resource_id": 831,
          "text": "Aur maamuli zarurat ki cheezen (logon ko) dene se gurez karte hai"
        }
      ]
    }
  ]
}