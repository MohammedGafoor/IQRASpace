    "translated_name": {
      "language_name": "english",
      "name": "The Emissaries"
    }
  },
  "verses": [
    {
      "id": 5623,
      "verse_number": 1,
      "verse_key": "77:1",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلْمُرْسَلَـٰتِ عُرْفًا",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407326,
          "resource_id": 85,
          "text": "By the [winds] sent forth in swift succession,"
        }
      ]
    },
    {
      "id": 5624,
      "verse_number": 2,
      "verse_key": "77:2",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407327,
          "resource_id": 85,
          "text": "violently storming,"
        }
      ]
    },
    {
      "id": 5625,
      "verse_number": 3,
      "verse_key": "77:3",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّـٰشِرَٰتِ نَشْرًا",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407328,
          "resource_id": 85,
          "text": "scattering far and wide,"
        }
      ]
    },
    {
      "id": 5626,
      "verse_number": 4,
      "verse_key": "77:4",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407329,
          "resource_id": 85,
          "text": "separating forcefully,"
        }
      ]
    },
    {
      "id": 5627,
      "verse_number": 5,
      "verse_key": "77:5",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407330,
          "resource_id": 85,
          "text": "delivering a reminder,"
        }
      ]
    },
    {
      "id": 5628,
      "verse_number": 6,
      "verse_key": "77:6",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عُذْرًا أَوْ نُذْرًا",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407331,
          "resource_id": 85,
          "text": "as a proof or a warning:"
        }
      ]
    },
    {
      "id": 5629,
      "verse_number": 7,
      "verse_key": "77:7",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407332,
          "resource_id": 85,
          "text": "what you are promised will come to pass."
        }
      ]
    },
    {
      "id": 5630,
      "verse_number": 8,
      "verse_key": "77:8",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407333,
          "resource_id": 85,
          "text": "When the stars are dimmed"
        }
      ]
    },
    {
      "id": 5631,
      "verse_number": 9,
      "verse_key": "77:9",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407334,
          "resource_id": 85,
          "text": "and the sky is torn apart,"
        }
      ]
    },
    {
      "id": 5632,
      "verse_number": 10,
      "verse_key": "77:10",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407335,
          "resource_id": 85,
          "text": "when the mountains are turned to dust"
        }
      ]
    },
    {
      "id": 5633,
      "verse_number": 11,
      "verse_key": "77:11",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407336,
          "resource_id": 85,
          "text": "and the messengers given their appointed time––"
        }
      ]
    },
    {
      "id": 5634,
      "verse_number": 12,
      "verse_key": "77:12",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407337,
          "resource_id": 85,
          "text": "for what Day has all this been set?"
        }
      ]
    },
    {
      "id": 5635,
      "verse_number": 13,
      "verse_key": "77:13",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِيَوْمِ ٱلْفَصْلِ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407338,
          "resource_id": 85,
          "text": "The Day of Decision."
        }
      ]
    },
    {
      "id": 5636,
      "verse_number": 14,
      "verse_key": "77:14",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407339,
          "resource_id": 85,
          "text": "What will explain to you what the Day of Decision is?"
        }
      ]
    },
    {
      "id": 5637,
      "verse_number": 15,
      "verse_key": "77:15",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407340,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5638,
      "verse_number": 16,
      "verse_key": "77:16",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407341,
          "resource_id": 85,
          "text": "Did We not destroy the first [of them]?"
        }
      ]
    },
    {
      "id": 5639,
      "verse_number": 17,
      "verse_key": "77:17",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407342,
          "resource_id": 85,
          "text": "We shall make the last follow them:"
        }
      ]
    },
    {
      "id": 5640,
      "verse_number": 18,
      "verse_key": "77:18",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407343,
          "resource_id": 85,
          "text": "this is how We deal with the guilty."
        }
      ]
    },
    {
      "id": 5641,
      "verse_number": 19,
      "verse_key": "77:19",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 580,
      "juz_number": 29,
      "translations": [
        {
          "id": 407344,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5642,
      "verse_number": 20,
      "verse_key": "77:20",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407345,
          "resource_id": 85,
          "text": "Did We not make you from an underrated fluid"
        }
      ]
    },
    {
      "id": 5643,
      "verse_number": 21,
      "verse_key": "77:21",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407346,
          "resource_id": 85,
          "text": "which We housed in a safe lodging"
        }
      ]
    },
    {
      "id": 5644,
      "verse_number": 22,
      "verse_key": "77:22",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407347,
          "resource_id": 85,
          "text": "for a determined period?"
        }
      ]
    },
    {
      "id": 5645,
      "verse_number": 23,
      "verse_key": "77:23",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407348,
          "resource_id": 85,
          "text": "We determine [it]: how excellently We determine!"
        }
      ]
    },
    {
      "id": 5646,
      "verse_number": 24,
      "verse_key": "77:24",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407349,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5647,
      "verse_number": 25,
      "verse_key": "77:25",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407350,
          "resource_id": 85,
          "text": "Did We not make the earth a home"
        }
      ]
    },
    {
      "id": 5648,
      "verse_number": 26,
      "verse_key": "77:26",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَحْيَآءً وَأَمْوَٰتًا",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407351,
          "resource_id": 85,
          "text": "for the living and the dead?"
        }
      ]
    },
    {
      "id": 5649,
      "verse_number": 27,
      "verse_key": "77:27",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407352,
          "resource_id": 85,
          "text": "Did We not place firm, lofty mountains on it and provide you with sweet water?"
        }
      ]
    },
    {
      "id": 5650,
      "verse_number": 28,
      "verse_key": "77:28",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407353,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5651,
      "verse_number": 29,
      "verse_key": "77:29",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407354,
          "resource_id": 85,
          "text": "They will be told, ‘Go to that which you used to deny!"
        }
      ]
    },
    {
      "id": 5652,
      "verse_number": 30,
      "verse_key": "77:30",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407355,
          "resource_id": 85,
          "text": "Go to a shadow of smoke!’ It rises in three columns;"
        }
      ]
    },
    {
      "id": 5653,
      "verse_number": 31,
      "verse_key": "77:31",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407356,
          "resource_id": 85,
          "text": "no shade does it give, nor relief from the flame;"
        }
      ]
    },
    {
      "id": 5654,
      "verse_number": 32,
      "verse_key": "77:32",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407357,
          "resource_id": 85,
          "text": "it shoots out sparks as large as treetrunks"
        }
      ]
    },
    {
      "id": 5655,
      "verse_number": 33,
      "verse_key": "77:33",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407358,
          "resource_id": 85,
          "text": "and as bright as copper."
        }
      ]
    },
    {
      "id": 5656,
      "verse_number": 34,
      "verse_key": "77:34",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407359,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5657,
      "verse_number": 35,
      "verse_key": "77:35",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407360,
          "resource_id": 85,
          "text": "On that Day they will be speechless,"
        }
      ]
    },
    {
      "id": 5658,
      "verse_number": 36,
      "verse_key": "77:36",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407361,
          "resource_id": 85,
          "text": "and they will be given no chance to offer any excuses."
        }
      ]
    },
    {
      "id": 5659,
      "verse_number": 37,
      "verse_key": "77:37",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407362,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5660,
      "verse_number": 38,
      "verse_key": "77:38",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407363,
          "resource_id": 85,
          "text": "[They will be told], ‘This is the Day of Decision: We have gathered you and earlier generations."
        }
      ]
    },
    {
      "id": 5661,
      "verse_number": 39,
      "verse_key": "77:39",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407364,
          "resource_id": 85,
          "text": "If you have any plots against Me, try them now.’"
        }
      ]
    },
    {
      "id": 5662,
      "verse_number": 40,
      "verse_key": "77:40",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 518,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407365,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5663,
      "verse_number": 41,
      "verse_key": "77:41",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407366,
          "resource_id": 85,
          "text": "But those who took heed of God will enjoy cool shade, springs,"
        }
      ]
    },
    {
      "id": 5664,
      "verse_number": 42,
      "verse_key": "77:42",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407367,
          "resource_id": 85,
          "text": "and any fruit they desire;"
        }
      ]
    },
    {
      "id": 5665,
      "verse_number": 43,
      "verse_key": "77:43",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407368,
          "resource_id": 85,
          "text": "[they will be told], ‘Eat and drink to your hearts’ content as a reward for your deeds:"
        }
      ]
    },
    {
      "id": 5666,
      "verse_number": 44,
      "verse_key": "77:44",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407369,
          "resource_id": 85,
          "text": "this is how We reward those who do good.’"
        }
      ]
    },
    {
      "id": 5667,
      "verse_number": 45,
      "verse_key": "77:45",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407370,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5668,
      "verse_number": 46,
      "verse_key": "77:46",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407371,
          "resource_id": 85,
          "text": "[You may] eat and enjoy yourselves for a short while, evildoers that you are."
        }
      ]
    },
    {
      "id": 5669,
      "verse_number": 47,
      "verse_key": "77:47",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407372,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5670,
      "verse_number": 48,
      "verse_key": "77:48",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407373,
          "resource_id": 85,
          "text": "When they are told, ‘Bow down in prayer,’ they do not do so."
        }
      ]
    },
    {
      "id": 5671,
      "verse_number": 49,
      "verse_key": "77:49",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407374,
          "resource_id": 85,
          "text": "Woe, on that Day, to those who denied the truth!"
        }
      ]
    },
    {
      "id": 5672,
      "verse_number": 50,
      "verse_key": "77:50",
      "hizb_number": 58,
      "rub_el_hizb_number": 232,
      "ruku_number": 519,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
      "page_number": 581,
      "juz_number": 29,
      "translations": [
        {
          "id": 407375,
          "resource_id": 85,
          "text": "In what revelation, after this, will they believe?"
        }
      ]
    }
  ]
}