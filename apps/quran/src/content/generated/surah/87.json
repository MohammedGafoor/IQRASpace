{
  "syncedAt": "2026-08-31T05:21:23.128Z",
  "chapter": {
    "id": 87,
    "revelation_place": "makkah",
    "revelation_order": 8,
    "bismillah_pre": true,
    "name_simple": "Al-A'la",
    "name_complex": "Al-'A`lá",
    "name_arabic": "الأعلى",
    "verses_count": 19,
    "pages": [
      591,
      592
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Most High"
    }
  },
  "verses": [
    {
      "id": 5949,
      "verse_number": 1,
      "verse_key": "87:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407652,
          "resource_id": 85,
          "text": "[Prophet], glorify the name of your Lord the Most High,"
        }
      ]
    },
    {
      "id": 5950,
      "verse_number": 2,
      "verse_key": "87:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407653,
          "resource_id": 85,
          "text": "who created [all things] in due proportion;"
        }
      ]
    },
    {
      "id": 5951,
      "verse_number": 3,
      "verse_key": "87:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407654,
          "resource_id": 85,
          "text": "who determined their destinies and guided them;"
        }
      ]
    },
    {
      "id": 5952,
      "verse_number": 4,
      "verse_key": "87:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407655,
          "resource_id": 85,
          "text": "who brought out the green pasture"
        }
      ]
    },
    {
      "id": 5953,
      "verse_number": 5,
      "verse_key": "87:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407656,
          "resource_id": 85,
          "text": "then made it dark debris."
        }
      ]
    },
    {
      "id": 5954,
      "verse_number": 6,
      "verse_key": "87:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407657,
          "resource_id": 85,
          "text": "[Prophet], We shall teach you [the Quran] and you will not forget––"
        }
      ]
    },
    {
      "id": 5955,
      "verse_number": 7,
      "verse_key": "87:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407658,
          "resource_id": 85,
          "text": "unless God wishes; He knows both what is open and what is hidden––"
        }
      ]
    },
    {
      "id": 5956,
      "verse_number": 8,
      "verse_key": "87:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407659,
          "resource_id": 85,
          "text": "We shall show you the easy way."
        }
      ]
    },
    {
      "id": 5957,
      "verse_number": 9,
      "verse_key": "87:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407660,
          "resource_id": 85,
          "text": "So remind, if reminding will help."
        }
      ]
    },
    {
      "id": 5958,
      "verse_number": 10,
      "verse_key": "87:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407661,
          "resource_id": 85,
          "text": "Those who stand in awe of God will heed the reminder,"
        }
      ]
    },
    {
      "id": 5959,
      "verse_number": 11,
      "verse_key": "87:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407662,
          "resource_id": 85,
          "text": "but it will be ignored by the most wicked,"
        }
      ]
    },
    {
      "id": 5960,
      "verse_number": 12,
      "verse_key": "87:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407663,
          "resource_id": 85,
          "text": "who will enter the Great Fire,"
        }
      ]
    },
    {
      "id": 5961,
      "verse_number": 13,
      "verse_key": "87:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407664,
          "resource_id": 85,
          "text": "where they will neither die nor live."
        }
      ]
    },
    {
      "id": 5962,
      "verse_number": 14,
      "verse_key": "87:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407665,
          "resource_id": 85,
          "text": "Prosperous are those who purify themselves,"
        }
      ]
    },
    {
      "id": 5963,
      "verse_number": 15,
      "verse_key": "87:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407666,
          "resource_id": 85,
          "text": "remember the name of their Lord, and pray."
        }
      ]
    },
    {
      "id": 5964,
      "verse_number": 16,
      "verse_key": "87:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407667,
          "resource_id": 85,
          "text": "Yet you [people] prefer the life of this world,"
        }
      ]
    },
    {
      "id": 5965,
      "verse_number": 17,
      "verse_key": "87:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407668,
          "resource_id": 85,
          "text": "even though the Hereafter is better and more lasting."
        }
      ]
    },
    {
      "id": 5966,
      "verse_number": 18,
      "verse_key": "87:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407669,
          "resource_id": 85,
          "text": "All this is in the earlier scriptures,"
        }
      ]
    },
    {
      "id": 5967,
      "verse_number": 19,
      "verse_key": "87:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407670,
          "resource_id": 85,
          "text": "the scriptures of Abraham and Moses."
        }
      ]
    }
  ]
}