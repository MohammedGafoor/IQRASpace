{
  "syncedAt": "2026-08-31T09:57:44.563Z",
  "chapter": {
    "id": 75,
    "revelation_place": "makkah",
    "revelation_order": 31,
    "bismillah_pre": true,
    "name_simple": "Al-Qiyamah",
    "name_complex": "Al-Qiyāmah",
    "name_arabic": "القيامة",
    "verses_count": 40,
    "pages": [
      577,
      578
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Resurrection"
    }
  },
  "verses": [
    {
      "id": 5552,
      "verse_number": 1,
      "verse_key": "75:1",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407255,
          "resource_id": 85,
          "text": "By the Day of Resurrection"
        },
        {
          "id": 1549989,
          "resource_id": 831,
          "text": "Nahin main kasam khata hoon qayamat ke din ki"
        }
      ]
    },
    {
      "id": 5553,
      "verse_number": 2,
      "verse_key": "75:2",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407256,
          "resource_id": 85,
          "text": "and by the self-reproaching soul!"
        },
        {
          "id": 1549990,
          "resource_id": 831,
          "text": "Aur nahin,main kasam khata hoon malamat karne wale nafs ki"
        }
      ]
    },
    {
      "id": 5554,
      "verse_number": 3,
      "verse_key": "75:3",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407257,
          "resource_id": 85,
          "text": "Does man think We shall not put his bones back together?"
        },
        {
          "id": 1549991,
          "resource_id": 831,
          "text": "Kya Insan yeh samajh raha hai ke hum uski haddiyon ko jama na kar sakengey"
        }
      ]
    },
    {
      "id": 5555,
      "verse_number": 4,
      "verse_key": "75:4",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407258,
          "resource_id": 85,
          "text": "In fact, We can reshape his very fingertips."
        },
        {
          "id": 1549992,
          "resource_id": 831,
          "text": "Kyun nahin? Hum to uski ungliyon ke por por tak theek bana dene par qadir hain"
        }
      ]
    },
    {
      "id": 5556,
      "verse_number": 5,
      "verse_key": "75:5",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407259,
          "resource_id": 85,
          "text": "Yet man wants to deny what is ahead of him:"
        },
        {
          "id": 1549993,
          "resource_id": 831,
          "text": "Magar Insan chahta yeh hai ke aagey bhi badh-aamaliyan karta rahey"
        }
      ]
    },
    {
      "id": 5557,
      "verse_number": 6,
      "verse_key": "75:6",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407260,
          "resource_id": 85,
          "text": "he says, ‘So, when will this Day of Resurrection be?’"
        },
        {
          "id": 1549994,
          "resource_id": 831,
          "text": "“Puchta hai” aakhir kab aana hai woh qayamat ka din"
        }
      ]
    },
    {
      "id": 5558,
      "verse_number": 7,
      "verse_key": "75:7",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407261,
          "resource_id": 85,
          "text": "When eyes are dazzled"
        },
        {
          "id": 1549995,
          "resource_id": 831,
          "text": "Phir jab dedhey pathra jayengey (sight is dazed)"
        }
      ]
    },
    {
      "id": 5559,
      "verse_number": 8,
      "verse_key": "75:8",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَخَسَفَ ٱلْقَمَرُ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407262,
          "resource_id": 85,
          "text": "and the moon eclipsed,"
        },
        {
          "id": 1549996,
          "resource_id": 831,
          "text": "Aur chand be-noor ho jayega"
        }
      ]
    },
    {
      "id": 5560,
      "verse_number": 9,
      "verse_key": "75:9",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407263,
          "resource_id": 85,
          "text": "when the sun and the moon are brought together,"
        },
        {
          "id": 1549997,
          "resource_id": 831,
          "text": "Aur Chand Suraj mila kar ek kardiya jayenge"
        }
      ]
    },
    {
      "id": 5561,
      "verse_number": 10,
      "verse_key": "75:10",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407264,
          "resource_id": 85,
          "text": "on that Day man will say, ‘Where can I escape?’"
        },
        {
          "id": 1549998,
          "resource_id": 831,
          "text": "Us waqt yahi Insan kahega kahan bhaag kar jaun"
        }
      ]
    },
    {
      "id": 5562,
      "verse_number": 11,
      "verse_key": "75:11",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَا وَزَرَ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407265,
          "resource_id": 85,
          "text": "Truly, there is no refuge:"
        },
        {
          "id": 1549999,
          "resource_id": 831,
          "text": "Hargiz nahin,wahan koi jaye panaah na hogi"
        }
      ]
    },
    {
      "id": 5563,
      "verse_number": 12,
      "verse_key": "75:12",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407266,
          "resource_id": 85,
          "text": "they will all return to your Lord on that Day."
        },
        {
          "id": 1550000,
          "resource_id": 831,
          "text": "Us roz terey Rubb hi ke samney jaakar theharna hoga"
        }
      ]
    },
    {
      "id": 5564,
      "verse_number": 13,
      "verse_key": "75:13",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407267,
          "resource_id": 85,
          "text": "On that Day, man will be told what he put first and what he put last."
        },
        {
          "id": 1550001,
          "resource_id": 831,
          "text": "Us roz Insan ko uska sab agla pichla kiya karaya bata diya jayega"
        }
      ]
    },
    {
      "id": 5565,
      "verse_number": 14,
      "verse_key": "75:14",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407268,
          "resource_id": 85,
          "text": "Truly, man is a clear witness against himself,"
        },
        {
          "id": 1550002,
          "resource_id": 831,
          "text": "Balke Insan khud hi apne aap ko khoob janta hai"
        }
      ]
    },
    {
      "id": 5566,
      "verse_number": 15,
      "verse_key": "75:15",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407269,
          "resource_id": 85,
          "text": "despite all the excuses he may put forward."
        },
        {
          "id": 1550003,
          "resource_id": 831,
          "text": "Chahey woh kitni hi maazratein (excuses) karey"
        }
      ]
    },
    {
      "id": 5567,
      "verse_number": 16,
      "verse_key": "75:16",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407270,
          "resource_id": 85,
          "text": "[Prophet], do not rush your tongue in an attempt to hasten [your memorization of] the Revelation:"
        },
        {
          "id": 1550004,
          "resource_id": 831,
          "text": "Aey Nabi , Is wahi ko jaldi jaldi yaad karne ke liye apni zubaan ko harkat na do"
        }
      ]
    },
    {
      "id": 5568,
      "verse_number": 17,
      "verse_key": "75:17",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407271,
          "resource_id": 85,
          "text": "We shall make sure of its safe collection and recitation."
        },
        {
          "id": 1550005,
          "resource_id": 831,
          "text": "Isko yaad kara dena aur padhwa dena hamare zimmey hai"
        }
      ]
    },
    {
      "id": 5569,
      "verse_number": 18,
      "verse_key": "75:18",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407272,
          "resource_id": 85,
          "text": "When We have recited it, repeat the recitation"
        },
        {
          "id": 1550006,
          "resource_id": 831,
          "text": "Lihaza jab hum isey padh rahey hon us waqt tum iske qirat ko gaur se sunte raho"
        }
      ]
    },
    {
      "id": 5570,
      "verse_number": 19,
      "verse_key": "75:19",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "page_number": 577,
      "juz_number": 29,
      "translations": [
        {
          "id": 407273,
          "resource_id": 85,
          "text": "and We shall make it clear."
        },
        {
          "id": 1550007,
          "resource_id": 831,
          "text": "Phir iska matlab samjha dena bhi hamarey zimmey hai"
        }
      ]
    },
    {
      "id": 5571,
      "verse_number": 20,
      "verse_key": "75:20",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407274,
          "resource_id": 85,
          "text": "Truly you [people] love this fleeting world"
        },
        {
          "id": 1550008,
          "resource_id": 831,
          "text": "Hargiz nahin, asal baat yeh hai ke tum log jaldi haasil honay wali cheez (yani duniya) se muhabbat rakhte ho"
        }
      ]
    },
    {
      "id": 5572,
      "verse_number": 21,
      "verse_key": "75:21",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407275,
          "resource_id": 85,
          "text": "and neglect the life to come."
        },
        {
          "id": 1550009,
          "resource_id": 831,
          "text": "Aur aakhirat ko chodh dete ho"
        }
      ]
    },
    {
      "id": 5573,
      "verse_number": 22,
      "verse_key": "75:22",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407276,
          "resource_id": 85,
          "text": "On that Day there will be radiant faces,"
        },
        {
          "id": 1550010,
          "resource_id": 831,
          "text": "Us roz kuch chehrey tar-o-taza hongey"
        }
      ]
    },
    {
      "id": 5574,
      "verse_number": 23,
      "verse_key": "75:23",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَىٰ رَبِّهَا نَاظِرَةٌ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407277,
          "resource_id": 85,
          "text": "looking towards their Lord,"
        },
        {
          "id": 1550011,
          "resource_id": 831,
          "text": "Apne Rubb ki taraf dekh rahey hongey"
        }
      ]
    },
    {
      "id": 5575,
      "verse_number": 24,
      "verse_key": "75:24",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407278,
          "resource_id": 85,
          "text": "and on that Day there will be the sad and despairing faces"
        },
        {
          "id": 1550012,
          "resource_id": 831,
          "text": "Aur kuch chehrey udas hongey"
        }
      ]
    },
    {
      "id": 5576,
      "verse_number": 25,
      "verse_key": "75:25",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407279,
          "resource_id": 85,
          "text": "of those who realize that a great calamity is about to befall them."
        },
        {
          "id": 1550013,
          "resource_id": 831,
          "text": "Aur samajh rahey hongey ke unke saath qamar-todh bartao hone wala hai"
        }
      ]
    },
    {
      "id": 5577,
      "verse_number": 26,
      "verse_key": "75:26",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407280,
          "resource_id": 85,
          "text": "Truly, when the soul reaches the collarbone;"
        },
        {
          "id": 1550014,
          "resource_id": 831,
          "text": "Hargiz nahin, jab jaan halaq tak pahunch jayegi"
        }
      ]
    },
    {
      "id": 5578,
      "verse_number": 27,
      "verse_key": "75:27",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَقِيلَ مَنْ ۜ رَاقٍ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407281,
          "resource_id": 85,
          "text": "when it is said, ‘Could any charm-healer save him now?’;"
        },
        {
          "id": 1550015,
          "resource_id": 831,
          "text": "Aur kaha jayega ke hai koi jhaad phook karne wala"
        }
      ]
    },
    {
      "id": 5579,
      "verse_number": 28,
      "verse_key": "75:28",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407282,
          "resource_id": 85,
          "text": "when he knows it is the final parting;"
        },
        {
          "id": 1550016,
          "resource_id": 831,
          "text": "Aur aadmi samajh lega ke yeh duniya se judai ka waqt hai"
        }
      ]
    },
    {
      "id": 5580,
      "verse_number": 29,
      "verse_key": "75:29",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407283,
          "resource_id": 85,
          "text": "when his legs are brought together:"
        },
        {
          "id": 1550017,
          "resource_id": 831,
          "text": "Aur pindli(leg) se pindli(leg) judh jayegi"
        }
      ]
    },
    {
      "id": 5581,
      "verse_number": 30,
      "verse_key": "75:30",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 514,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407284,
          "resource_id": 85,
          "text": "on that day he will be driven towards your Lord."
        },
        {
          "id": 1550018,
          "resource_id": 831,
          "text": "Woh din hoga tere Rubb ki taraf rawangi ka"
        }
      ]
    },
    {
      "id": 5582,
      "verse_number": 31,
      "verse_key": "75:31",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407285,
          "resource_id": 85,
          "text": "He neither believed nor prayed,"
        },
        {
          "id": 1550019,
          "resource_id": 831,
          "text": "Magar usne na sach mana , aur na namaz padhi"
        }
      ]
    },
    {
      "id": 5583,
      "verse_number": 32,
      "verse_key": "75:32",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407286,
          "resource_id": 85,
          "text": "but denied the truth and turned away,"
        },
        {
          "id": 1550020,
          "resource_id": 831,
          "text": "Balke jhutlaya aur palat gaya"
        }
      ]
    },
    {
      "id": 5584,
      "verse_number": 33,
      "verse_key": "75:33",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407287,
          "resource_id": 85,
          "text": "walking back to his people with a conceited swagger."
        },
        {
          "id": 1550021,
          "resource_id": 831,
          "text": "Phir akadta hua apne ghar walon ki taraf chal diya"
        }
      ]
    },
    {
      "id": 5585,
      "verse_number": 34,
      "verse_key": "75:34",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407288,
          "resource_id": 85,
          "text": "Closer and closer it comes to you."
        },
        {
          "id": 1550022,
          "resource_id": 831,
          "text": "Yeh rawish tere hi liye sazawaar hai aur tujh hi ko zeib deti hai"
        }
      ]
    },
    {
      "id": 5586,
      "verse_number": 35,
      "verse_key": "75:35",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407289,
          "resource_id": 85,
          "text": "Closer and closer still."
        },
        {
          "id": 1550023,
          "resource_id": 831,
          "text": "Haan yeh rawish tere hi liye sazawaar hai aur tujh hi ko zeib deti hai"
        }
      ]
    },
    {
      "id": 5587,
      "verse_number": 36,
      "verse_key": "75:36",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407290,
          "resource_id": 85,
          "text": "Does man think he will be left alone?"
        },
        {
          "id": 1550024,
          "resource_id": 831,
          "text": "Kya Insan ne yeh samajh rakkha hai ke woh yunhi mohmal (left alone, unquestioned )chodh diya jayega"
        }
      ]
    },
    {
      "id": 5588,
      "verse_number": 37,
      "verse_key": "75:37",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407291,
          "resource_id": 85,
          "text": "Was he not just a drop of spilt-out sperm,"
        },
        {
          "id": 1550025,
          "resource_id": 831,
          "text": "Kya woh ek hakeer pani ka nutfa (sperm from semen) na tha jo (raham –e-madar mei) tapkaya jata hai"
        }
      ]
    },
    {
      "id": 5589,
      "verse_number": 38,
      "verse_key": "75:38",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407292,
          "resource_id": 85,
          "text": "which became a clinging form, which God shaped in due proportion,"
        },
        {
          "id": 1550026,
          "resource_id": 831,
          "text": "Phir woh ek lothda(clot) bana, phir Allah ne uska jism banaya aur uske aazaa durust kiye"
        }
      ]
    },
    {
      "id": 5590,
      "verse_number": 39,
      "verse_key": "75:39",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407293,
          "resource_id": 85,
          "text": "fashioning from it the two sexes, male and female?"
        },
        {
          "id": 1550027,
          "resource_id": 831,
          "text": "Phir ussey mard aur aurat ki do qismein banayi"
        }
      ]
    },
    {
      "id": 5591,
      "verse_number": 40,
      "verse_key": "75:40",
      "hizb_number": 58,
      "rub_el_hizb_number": 231,
      "ruku_number": 515,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ",
      "page_number": 578,
      "juz_number": 29,
      "translations": [
        {
          "id": 407294,
          "resource_id": 85,
          "text": "Does He who can do this not have the power to bring the dead back to life?"
        },
        {
          "id": 1550028,
          "resource_id": 831,
          "text": "Kya woh ispar qadir nahin hai ke marne walon ko phir zinda karde"
        }
      ]
    }
  ]
}