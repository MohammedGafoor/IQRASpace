    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Clot"
    }
  },
  "verses": [
    {
      "id": 6107,
      "verse_number": 1,
      "verse_key": "96:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407810,
          "resource_id": 85,
          "text": "Read! In the name of your Lord who created:"
        }
      ]
    },
    {
      "id": 6108,
      "verse_number": 2,
      "verse_key": "96:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407811,
          "resource_id": 85,
          "text": "He created man from a clinging form."
        }
      ]
    },
    {
      "id": 6109,
      "verse_number": 3,
      "verse_key": "96:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407812,
          "resource_id": 85,
          "text": "Read! Your Lord is the Most Bountiful One"
        }
      ]
    },
    {
      "id": 6110,
      "verse_number": 4,
      "verse_key": "96:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407813,
          "resource_id": 85,
          "text": "who taught by [means of] the pen,"
        }
      ]
    },
    {
      "id": 6111,
      "verse_number": 5,
      "verse_key": "96:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407814,
          "resource_id": 85,
          "text": "who taught man what he did not know."
        }
      ]
    },
    {
      "id": 6112,
      "verse_number": 6,
      "verse_key": "96:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407815,
          "resource_id": 85,
          "text": "But man exceeds all bounds"
        }
      ]
    },
    {
      "id": 6113,
      "verse_number": 7,
      "verse_key": "96:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407816,
          "resource_id": 85,
          "text": "when he thinks he is self-sufficient:"
        }
      ]
    },
    {
      "id": 6114,
      "verse_number": 8,
      "verse_key": "96:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407817,
          "resource_id": 85,
          "text": "[Prophet], all will return to your Lord."
        }
      ]
    },
    {
      "id": 6115,
      "verse_number": 9,
      "verse_key": "96:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407818,
          "resource_id": 85,
          "text": "Have you seen the man who forbids"
        }
      ]
    },
    {
      "id": 6116,
      "verse_number": 10,
      "verse_key": "96:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَبْدًا إِذَا صَلَّىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407819,
          "resource_id": 85,
          "text": "[Our] servant to pray?"
        }
      ]
    },
    {
      "id": 6117,
      "verse_number": 11,
      "verse_key": "96:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407820,
          "resource_id": 85,
          "text": "Have you seen whether he is rightly guided,"
        }
      ]
    },
    {
      "id": 6118,
      "verse_number": 12,
      "verse_key": "96:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407821,
          "resource_id": 85,
          "text": "or encourages true piety?"
        }
      ]
    },
    {
      "id": 6119,
      "verse_number": 13,
      "verse_key": "96:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407822,
          "resource_id": 85,
          "text": "Have you seen whether he denies the truth and turns away from it?"
        }
      ]
    },
    {
      "id": 6120,
      "verse_number": 14,
      "verse_key": "96:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407823,
          "resource_id": 85,
          "text": "Does he not realize that God sees all?"
        }
      ]
    },
    {
      "id": 6121,
      "verse_number": 15,
      "verse_key": "96:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407824,
          "resource_id": 85,
          "text": "No! If he does not stop, We shall drag him by his forehead––"
        }
      ]
    },
    {
      "id": 6122,
      "verse_number": 16,
      "verse_key": "96:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407825,
          "resource_id": 85,
          "text": "his lying, sinful forehead."
        }
      ]
    },
    {
      "id": 6123,
      "verse_number": 17,
      "verse_key": "96:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَدْعُ نَادِيَهُۥ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407826,
          "resource_id": 85,
          "text": "Let him summon his comrades;"
        }
      ]
    },
    {
      "id": 6124,
      "verse_number": 18,
      "verse_key": "96:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407827,
          "resource_id": 85,
          "text": "We shall summon the guards of Hell."
        }
      ]
    },
    {
      "id": 6125,
      "verse_number": 19,
      "verse_key": "96:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": 14,
      "text_uthmani": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407828,
          "resource_id": 85,
          "text": "No! Do not obey him [Prophet]: bow down in worship and draw close."
        }
      ]
    }
  ]
}