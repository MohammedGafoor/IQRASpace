{
  "syncedAt": "2026-08-31T09:57:53.530Z",
  "chapter": {
    "id": 96,
    "revelation_place": "makkah",
    "revelation_order": 1,
    "bismillah_pre": true,
    "name_simple": "Al-'Alaq",
    "name_complex": "Al-`Alaq",
    "name_arabic": "العلق",
    "verses_count": 19,
    "pages": [
      597,
      597
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Clot"
    }
  },
  "verses": [
    {
      "id": 6107,
      "verse_number": 1,
      "verse_key": "96:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407810,
          "resource_id": 85,
          "text": "Read! In the name of your Lord who created:"
        },
        {
          "id": 1550544,
          "resource_id": 831,
          "text": "Padho (Aey Nabi) apne Rubb ke naam ke saath Jisne paida kiya"
        }
      ]
    },
    {
      "id": 6108,
      "verse_number": 2,
      "verse_key": "96:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407811,
          "resource_id": 85,
          "text": "He created man from a clinging form."
        },
        {
          "id": 1550545,
          "resource_id": 831,
          "text": "Jamey huey khoon ke ek lothdey se Insan ki takhliq ki"
        }
      ]
    },
    {
      "id": 6109,
      "verse_number": 3,
      "verse_key": "96:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407812,
          "resource_id": 85,
          "text": "Read! Your Lord is the Most Bountiful One"
        },
        {
          "id": 1550546,
          "resource_id": 831,
          "text": "Padho aur tumhara Rubb bada kareem hai"
        }
      ]
    },
    {
      "id": 6110,
      "verse_number": 4,
      "verse_key": "96:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407813,
          "resource_id": 85,
          "text": "who taught by [means of] the pen,"
        },
        {
          "id": 1550547,
          "resource_id": 831,
          "text": "jisne qalam ke zariya se ilm sikhaya"
        }
      ]
    },
    {
      "id": 6111,
      "verse_number": 5,
      "verse_key": "96:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407814,
          "resource_id": 85,
          "text": "who taught man what he did not know."
        },
        {
          "id": 1550548,
          "resource_id": 831,
          "text": "Insan ko woh ilm diya jisey woh na jaanta tha"
        }
      ]
    },
    {
      "id": 6112,
      "verse_number": 6,
      "verse_key": "96:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407815,
          "resource_id": 85,
          "text": "But man exceeds all bounds"
        },
        {
          "id": 1550549,
          "resource_id": 831,
          "text": "Hargiz nahin, Insan sarkahshi karta hai"
        }
      ]
    },
    {
      "id": 6113,
      "verse_number": 7,
      "verse_key": "96:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407816,
          "resource_id": 85,
          "text": "when he thinks he is self-sufficient:"
        },
        {
          "id": 1550550,
          "resource_id": 831,
          "text": "Is bina par ke woh apne aap ko be niyaz dekhta hai"
        }
      ]
    },
    {
      "id": 6114,
      "verse_number": 8,
      "verse_key": "96:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407817,
          "resource_id": 85,
          "text": "[Prophet], all will return to your Lord."
        },
        {
          "id": 1550551,
          "resource_id": 831,
          "text": "(halaanke) palatna yaqeenan tere Rubb hi ki taraf hai"
        }
      ]
    },
    {
      "id": 6115,
      "verse_number": 9,
      "verse_key": "96:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407818,
          "resource_id": 85,
          "text": "Have you seen the man who forbids"
        },
        {
          "id": 1550552,
          "resource_id": 831,
          "text": "Tumne dekha us shaks ko"
        }
      ]
    },
    {
      "id": 6116,
      "verse_number": 10,
      "verse_key": "96:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَبْدًا إِذَا صَلَّىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407819,
          "resource_id": 85,
          "text": "[Our] servant to pray?"
        },
        {
          "id": 1550553,
          "resource_id": 831,
          "text": "Jo ek banday ko mana karta hai jabke woh namaz padta ho"
        }
      ]
    },
    {
      "id": 6117,
      "verse_number": 11,
      "verse_key": "96:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407820,
          "resource_id": 85,
          "text": "Have you seen whether he is rightly guided,"
        },
        {
          "id": 1550554,
          "resource_id": 831,
          "text": "Tumhara kya khayal hai agar (woh banda) raah e raast par ho"
        }
      ]
    },
    {
      "id": 6118,
      "verse_number": 12,
      "verse_key": "96:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407821,
          "resource_id": 85,
          "text": "or encourages true piety?"
        },
        {
          "id": 1550555,
          "resource_id": 831,
          "text": "ya parhezgari ki talqeen karta ho"
        }
      ]
    },
    {
      "id": 6119,
      "verse_number": 13,
      "verse_key": "96:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407822,
          "resource_id": 85,
          "text": "Have you seen whether he denies the truth and turns away from it?"
        },
        {
          "id": 1550556,
          "resource_id": 831,
          "text": "Tumhara kya khayal hai agar (yeh mana karne wala shakhs haqq ko) jhutlata aur mooh moadta ho"
        }
      ]
    },
    {
      "id": 6120,
      "verse_number": 14,
      "verse_key": "96:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407823,
          "resource_id": 85,
          "text": "Does he not realize that God sees all?"
        },
        {
          "id": 1550557,
          "resource_id": 831,
          "text": "Kya woh nahin jaanta ke Allah dekh raha hai"
        }
      ]
    },
    {
      "id": 6121,
      "verse_number": 15,
      "verse_key": "96:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407824,
          "resource_id": 85,
          "text": "No! If he does not stop, We shall drag him by his forehead––"
        },
        {
          "id": 1550558,
          "resource_id": 831,
          "text": "Hargiz nahin agar woh baaz na aaya to hum uski peshani ke baal pakad kar usey khinchey ge"
        }
      ]
    },
    {
      "id": 6122,
      "verse_number": 16,
      "verse_key": "96:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407825,
          "resource_id": 85,
          "text": "his lying, sinful forehead."
        },
        {
          "id": 1550559,
          "resource_id": 831,
          "text": "Us peshani ko jo jhooti aur sakth khatakaar hai"
        }
      ]
    },
    {
      "id": 6123,
      "verse_number": 17,
      "verse_key": "96:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَدْعُ نَادِيَهُۥ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407826,
          "resource_id": 85,
          "text": "Let him summon his comrades;"
        },
        {
          "id": 1550560,
          "resource_id": 831,
          "text": "Woh bulaley apne haamiyon ki toli ko"
        }
      ]
    },
    {
      "id": 6124,
      "verse_number": 18,
      "verse_key": "96:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407827,
          "resource_id": 85,
          "text": "We shall summon the guards of Hell."
        },
        {
          "id": 1550561,
          "resource_id": 831,
          "text": "Hum bhi azaab ke farishton ko bula lengey"
        }
      ]
    },
    {
      "id": 6125,
      "verse_number": 19,
      "verse_key": "96:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": 14,
      "text_uthmani": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407828,
          "resource_id": 85,
          "text": "No! Do not obey him [Prophet]: bow down in worship and draw close."
        },
        {
          "id": 1550562,
          "resource_id": 831,
          "text": "Hargiz nahin, uski baat na mano aur sajda karo aur (apne Rubb ka) qurb hasil karo"
        }
      ]
    }
  ]
}