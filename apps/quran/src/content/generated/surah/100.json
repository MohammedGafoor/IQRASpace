    },
    {
      "id": 6148,
      "verse_number": 2,
      "verse_key": "100:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْمُورِيَـٰتِ قَدْحًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407851,
          "resource_id": 85,
          "text": "and strike sparks with their hooves,"
        }
      ]
    },
    {
      "id": 6149,
      "verse_number": 3,
      "verse_key": "100:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْمُغِيرَٰتِ صُبْحًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407852,
          "resource_id": 85,
          "text": "who make dawn raids,"
        }
      ]
    },
    {
      "id": 6150,
      "verse_number": 4,
      "verse_key": "100:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَثَرْنَ بِهِۦ نَقْعًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407853,
          "resource_id": 85,
          "text": "raising a cloud of dust,"
        }
      ]
    },
    {
      "id": 6151,
      "verse_number": 5,
      "verse_key": "100:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407854,
          "resource_id": 85,
          "text": "and plunging into the midst of the enemy,"
        }
      ]
    },
    {
      "id": 6152,
      "verse_number": 6,
      "verse_key": "100:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407855,
          "resource_id": 85,
          "text": "man is ungrateful to his Lord––"
        }
      ]
    },
    {
      "id": 6153,
      "verse_number": 7,
      "verse_key": "100:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407856,
          "resource_id": 85,
          "text": "and He is witness to this––"
        }
      ]
    },
    {
      "id": 6154,
      "verse_number": 8,
      "verse_key": "100:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407857,
          "resource_id": 85,
          "text": "he is truly excessive in his love of wealth."
        }
      ]
    },
    {
      "id": 6155,
      "verse_number": 9,
      "verse_key": "100:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407858,
          "resource_id": 85,
          "text": "Does he not know that when the contents of graves burst forth,"
        }
      ]
    },
    {
      "id": 6156,
      "verse_number": 10,
      "verse_key": "100:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407859,
          "resource_id": 85,
          "text": "when the secrets of hearts are uncovered, on that Day,"
        }
      ]
    },
    {
      "id": 6157,
      "verse_number": 11,
      "verse_key": "100:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407860,
          "resource_id": 85,
          "text": "their Lord will be fully aware of them all?"
        }
      ]
    }
  ]
