      "sajdah_number": null,
      "text_uthmani": " وَٱلْعَـٰدِيَـٰتِ ضَبْحًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407850,
          "resource_id": 85,
          "text": "By the charging steeds that pant"
        }
