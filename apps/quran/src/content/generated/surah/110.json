      "sajdah_number": null,
      "text_uthmani": " إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ",
      "page_number": 603,
      "juz_number": 30,
      "translations": [
        {
          "id": 407917,
          "resource_id": 85,
          "text": "When God’s help comes and He opens up your way [Prophet],"
        },
        {
          "id": 1550651,
          "resource_id": 831,
          "text": "Jab Allah ki madad aa jaye aur fatah naseeb ho jaye"
        }
      ]
    },
    {
      "id": 6215,
      "verse_number": 2,
      "verse_key": "110:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 554,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا",
      "page_number": 603,
      "juz_number": 30,
      "translations": [
        {
          "id": 407918,
          "resource_id": 85,
          "text": "when you see people embracing God’s faith in crowds,"
        },
        {
          "id": 1550652,
          "resource_id": 831,
          "text": "Aur (aey Nabi s.a.s) tum dekh lo ke log fauj dar fauj Allah ke deen mein dakhil ho rahey hain"
        }
      ]
    },
    {
      "id": 6216,
      "verse_number": 3,
      "verse_key": "110:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 554,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا",
      "page_number": 603,
      "juz_number": 30,
      "translations": [
        {
          "id": 407919,
          "resource_id": 85,
          "text": "celebrate the praise of your Lord and ask His forgiveness: He is always ready to accept repentance."
        },
        {
          "id": 1550653,
          "resource_id": 831,
          "text": "To apne Rubb ki hamd ke saath uski tasbeeh karo Aur us se magfirat ki duaa maango. Beshak woh bada tauba qabool karne wala hai"
        }
      ]
