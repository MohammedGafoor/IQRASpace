    ],
    "translated_name": {
      "language_name": "english",
      "name": "The City"
    }
  },
  "verses": [
    {
      "id": 6024,
      "verse_number": 1,
      "verse_key": "90:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407727,
          "resource_id": 85,
          "text": "I swear by this city––"
        }
      ]
    },
    {
      "id": 6025,
      "verse_number": 2,
      "verse_key": "90:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407728,
          "resource_id": 85,
          "text": "and you [Prophet] are an inhabitant of this city––"
        }
      ]
    },
    {
      "id": 6026,
      "verse_number": 3,
      "verse_key": "90:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوَالِدٍ وَمَا وَلَدَ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407729,
          "resource_id": 85,
          "text": "[I swear] by parent and offspring,"
        }
      ]
    },
    {
      "id": 6027,
      "verse_number": 4,
      "verse_key": "90:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407730,
          "resource_id": 85,
          "text": "that We have created man for toil and trial."
        }
      ]
    },
    {
      "id": 6028,
      "verse_number": 5,
      "verse_key": "90:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407731,
          "resource_id": 85,
          "text": "Does he think that no one will have power over him?"
        }
      ]
    },
    {
      "id": 6029,
      "verse_number": 6,
      "verse_key": "90:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407732,
          "resource_id": 85,
          "text": "‘I have squandered great wealth,’ he says."
        }
      ]
    },
    {
      "id": 6030,
      "verse_number": 7,
      "verse_key": "90:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407733,
          "resource_id": 85,
          "text": "Does he think no one observes him?"
        }
      ]
    },
    {
      "id": 6031,
      "verse_number": 8,
      "verse_key": "90:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407734,
          "resource_id": 85,
          "text": "Did We not give him eyes,"
        }
      ]
    },
    {
      "id": 6032,
      "verse_number": 9,
      "verse_key": "90:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلِسَانًا وَشَفَتَيْنِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407735,
          "resource_id": 85,
          "text": "a tongue, lips,"
        }
      ]
    },
    {
      "id": 6033,
      "verse_number": 10,
      "verse_key": "90:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407736,
          "resource_id": 85,
          "text": "and point out to him the two clear ways [of good and evil]?"
        }
      ]
    },
    {
      "id": 6034,
      "verse_number": 11,
      "verse_key": "90:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407737,
          "resource_id": 85,
          "text": "Yet he has not attempted the steep path."
        }
      ]
    },
    {
      "id": 6035,
      "verse_number": 12,
      "verse_key": "90:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407738,
          "resource_id": 85,
          "text": "What will explain to you what the steep path is?"
        }
      ]
    },
    {
      "id": 6036,
      "verse_number": 13,
      "verse_key": "90:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَكُّ رَقَبَةٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407739,
          "resource_id": 85,
          "text": "It is to free a slave,"
        }
      ]
    },
    {
      "id": 6037,
      "verse_number": 14,
      "verse_key": "90:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407740,
          "resource_id": 85,
          "text": "to feed at a time of hunger"
        }
      ]
    },
    {
      "id": 6038,
      "verse_number": 15,
      "verse_key": "90:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَتِيمًا ذَا مَقْرَبَةٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407741,
          "resource_id": 85,
          "text": "an orphaned relative"
        }
      ]
    },
    {
      "id": 6039,
      "verse_number": 16,
      "verse_key": "90:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407742,
          "resource_id": 85,
          "text": "or a poor person in distress,"
        }
      ]
    },
    {
      "id": 6040,
      "verse_number": 17,
      "verse_key": "90:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407743,
          "resource_id": 85,
          "text": "and to be one of those who believe and urge one another to steadfastness and compassion."
        }
      ]
    },
    {
      "id": 6041,
      "verse_number": 18,
      "verse_key": "90:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407744,
          "resource_id": 85,
          "text": "Those who do this will be on the right-hand side,"
        }
      ]
    },
    {
      "id": 6042,
      "verse_number": 19,
      "verse_key": "90:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407745,
          "resource_id": 85,
          "text": "but those who disbelieve in Our revelations will be on the left-hand side,"
        }
      ]
    },
    {
      "id": 6043,
      "verse_number": 20,
      "verse_key": "90:20",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407746,
          "resource_id": 85,
          "text": "and the Fire will close in on them."
        }
      ]
    }
  ]
}