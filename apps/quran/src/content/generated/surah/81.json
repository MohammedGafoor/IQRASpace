    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Overthrowing"
    }
  },
  "verses": [
    {
      "id": 5801,
      "verse_number": 1,
      "verse_key": "81:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407504,
          "resource_id": 85,
          "text": "When the sun is shrouded in darkness,"
        },
        {
          "id": 1550238,
          "resource_id": 831,
          "text": "Jab Suraj lapeit diya jayega"
        }
      ]
    },
    {
      "id": 5802,
      "verse_number": 2,
      "verse_key": "81:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407505,
          "resource_id": 85,
          "text": "when the stars are dimmed,"
        },
        {
          "id": 1550239,
          "resource_id": 831,
          "text": "Aur jab taarey bikhar jayenge"
        }
      ]
    },
    {
      "id": 5803,
      "verse_number": 3,
      "verse_key": "81:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407506,
          "resource_id": 85,
          "text": "when the mountains are set in motion,"
        },
        {
          "id": 1550240,
          "resource_id": 831,
          "text": "Aur jab pahad chalaye jayenge"
        }
      ]
    },
    {
      "id": 5804,
      "verse_number": 4,
      "verse_key": "81:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407507,
          "resource_id": 85,
          "text": "when pregnant camels are abandoned,"
        },
        {
          "id": 1550241,
          "resource_id": 831,
          "text": "Aur jab dus mahine ki hamila ountniyan (she-camels) apne haal par chod di jayengi"
        }
      ]
    },
    {
      "id": 5805,
      "verse_number": 5,
      "verse_key": "81:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407508,
          "resource_id": 85,
          "text": "when wild beasts are herded together,"
        },
        {
          "id": 1550242,
          "resource_id": 831,
          "text": "Aur jab jungli jaanwar sameth kar ikhattey kar diye jayenge"
        }
      ]
    },
    {
      "id": 5806,
      "verse_number": 6,
      "verse_key": "81:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407509,
          "resource_id": 85,
          "text": "when the seas boil over,"
        },
        {
          "id": 1550243,
          "resource_id": 831,
          "text": "Aur jab samandar bhadka diye jayenge"
        }
      ]
    },
    {
      "id": 5807,
      "verse_number": 7,
      "verse_key": "81:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407510,
          "resource_id": 85,
          "text": "when souls are sorted into classes,"
        },
        {
          "id": 1550244,
          "resource_id": 831,
          "text": "Aur jab jaane (Jismon se) jodh di jayengi"
        }
      ]
    },
    {
      "id": 5808,
      "verse_number": 8,
      "verse_key": "81:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407511,
          "resource_id": 85,
          "text": "when the baby girl buried alive is asked"
        },
        {
          "id": 1550245,
          "resource_id": 831,
          "text": "Aur jab zinda gaadi hui(buried) ladki se pucha jayega"
        }
      ]
    },
    {
      "id": 5809,
      "verse_number": 9,
      "verse_key": "81:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407512,
          "resource_id": 85,
          "text": "for what sin she was killed,"
        },
        {
          "id": 1550246,
          "resource_id": 831,
          "text": "ke woh kis kasoor mei mari gayi"
        }
      ]
    },
    {
      "id": 5810,
      "verse_number": 10,
      "verse_key": "81:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407513,
          "resource_id": 85,
          "text": "when the records of deeds are spread open,"
        },
        {
          "id": 1550247,
          "resource_id": 831,
          "text": "Aur jab aamal-naame(scrolls of deeds) kholey jayenge"
        }
      ]
    },
    {
      "id": 5811,
      "verse_number": 11,
      "verse_key": "81:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407514,
          "resource_id": 85,
          "text": "when the sky is stripped away,"
        },
        {
          "id": 1550248,
          "resource_id": 831,
          "text": "Aur jab aasman ka purda hata diya jayega"
        }
      ]
    },
    {
      "id": 5812,
      "verse_number": 12,
      "verse_key": "81:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407515,
          "resource_id": 85,
          "text": "when Hell is made to blaze"
        },
        {
          "id": 1550249,
          "resource_id": 831,
          "text": "Aur jab Jahannam dehkayi jayegi"
        }
      ]
    },
    {
      "id": 5813,
      "verse_number": 13,
      "verse_key": "81:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407516,
          "resource_id": 85,
          "text": "and Paradise brought near:"
        },
        {
          "id": 1550250,
          "resource_id": 831,
          "text": "Aur jab Jannat qareeb le aayi jayegi"
        }
      ]
    },
    {
      "id": 5814,
      "verse_number": 14,
      "verse_key": "81:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407517,
          "resource_id": 85,
          "text": "then every soul will know what it has brought about."
        },
        {
          "id": 1550251,
          "resource_id": 831,
          "text": "Us waqt har shaks ko maloom ho jayega ke woh kya lekar aaya hai"
        }
      ]
    },
    {
      "id": 5815,
      "verse_number": 15,
      "verse_key": "81:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407518,
          "resource_id": 85,
          "text": "I swear by the planets"
        },
        {
          "id": 1550252,
          "resource_id": 831,
          "text": "Pas nahin main kasam khata hoon"
        }
      ]
    },
    {
      "id": 5816,
      "verse_number": 16,
      "verse_key": "81:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407519,
          "resource_id": 85,
          "text": "that recede, move, and hide,"
        },
        {
          "id": 1550253,
          "resource_id": 831,
          "text": "Palatne aur chup janey wale taaron ki"
        }
      ]
    },
    {
      "id": 5817,
      "verse_number": 17,
      "verse_key": "81:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407520,
          "resource_id": 85,
          "text": "by the night that descends,"
        },
        {
          "id": 1550254,
          "resource_id": 831,
          "text": "Aur Raat ki jabke woh ruksat hui"
        }
      ]
    },
    {
      "id": 5818,
      "verse_number": 18,
      "verse_key": "81:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407521,
          "resource_id": 85,
          "text": "by the dawn that softly breathes:"
        },
        {
          "id": 1550255,
          "resource_id": 831,
          "text": "Aur subah ki jabke usne saans liya"
        }
      ]
    },
    {
      "id": 5819,
      "verse_number": 19,
      "verse_key": "81:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407522,
          "resource_id": 85,
          "text": "this is the speech of a noble messenger,"
        },
        {
          "id": 1550256,
          "resource_id": 831,
          "text": "Yeh fil waqea ek buzurg paigam-bar ka qaul(word) hai"
        }
      ]
    },
    {
      "id": 5820,
      "verse_number": 20,
      "verse_key": "81:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407523,
          "resource_id": 85,
          "text": "who possesses great strength and is held in honour by the Lord of the Throne––"
        },
        {
          "id": 1550257,
          "resource_id": 831,
          "text": "Jo badi tawanai (might) rakhta hai, Arsh waley ke yahan buland martaba hai"
        }
      ]
    },
    {
      "id": 5821,
      "verse_number": 21,
      "verse_key": "81:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407524,
          "resource_id": 85,
          "text": "he is obeyed there and worthy of trust."
        },
        {
          "id": 1550258,
          "resource_id": 831,
          "text": "Wahan uska hukum mana jata hai, Woh ba-aitamad (trustworthy) hai"
        }
      ]
    },
    {
      "id": 5822,
      "verse_number": 22,
      "verse_key": "81:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407525,
          "resource_id": 85,
          "text": "Your companion is not mad:"
        },
        {
          "id": 1550259,
          "resource_id": 831,
          "text": "Aur (aey ehle Makkah) tumhara rafeeq(companion) majnoon(mad) nahin hai"
        }
      ]
    },
    {
      "id": 5823,
      "verse_number": 23,
      "verse_key": "81:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407526,
          "resource_id": 85,
          "text": "he did see him on the clear horizon."
        },
        {
          "id": 1550260,
          "resource_id": 831,
          "text": "Usne us paigambar ko roshan ufaq (clear horizon) par dekha hai"
        }
      ]
    },
    {
      "id": 5824,
      "verse_number": 24,
      "verse_key": "81:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407527,
          "resource_id": 85,
          "text": "He does not withhold what is revealed to him from beyond."
        },
        {
          "id": 1550261,
          "resource_id": 831,
          "text": "Aur woh gaib (ke is ilam ko logon tak pahunchane) ke maamle mei bakheel nahin hai"
        }
      ]
    },
    {
      "id": 5825,
      "verse_number": 25,
      "verse_key": "81:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407528,
          "resource_id": 85,
          "text": "This is not the word of an outcast devil."
        },
        {
          "id": 1550262,
          "resource_id": 831,
          "text": "Aur yeh kisi shaitan-e-mardood ka qaul nahin hai"
        }
      ]
    },
    {
      "id": 5826,
      "verse_number": 26,
      "verse_key": "81:26",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَيْنَ تَذْهَبُونَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407529,
          "resource_id": 85,
          "text": "So where are you [people] going?"
        },
        {
          "id": 1550263,
          "resource_id": 831,
          "text": "Phir tum log kidhar chaley ja rahey ho"
        }
      ]
    },
    {
      "id": 5827,
      "verse_number": 27,
      "verse_key": "81:27",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407530,
          "resource_id": 85,
          "text": "This is a message for all people;"
        },
        {
          "id": 1550264,
          "resource_id": 831,
          "text": "Yeh to saarey jahan walon ke liye ek naseehat hai"
        }
      ]
    },
    {
      "id": 5828,
      "verse_number": 28,
      "verse_key": "81:28",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407531,
          "resource_id": 85,
          "text": "for those who wish to take the straight path."
        },
        {
          "id": 1550265,
          "resource_id": 831,
