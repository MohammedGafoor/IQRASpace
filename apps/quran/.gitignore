# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# Synced Quran content (see scripts/sync-content.mjs) — DELIBERATELY
# COMMITTED, not gitignored. Reasoning (found during the production
# deployment pass, see DEPLOYMENT.md): this is read at build time by
# generateStaticParams/getAllChapters (src/lib/content/quran.ts) for
# every SSG route. Leaving it untracked meant a fresh checkout — CI, or
# Vercel's own build — had no content and `next build` failed outright.
# Committing it: (a) fixes that, (b) matches ARCHITECTURE.md's own
# "immutable reference content, decoupled from live API calls" model,
# (c) avoids hitting the Quran Foundation API (rate limits, ~2 minutes)
# on every single CI run/deploy, and (d) mirrors this repo's existing
# precedent of treating content/schema updates as a deliberate, manual,
# separately-committed step (see apps/web's Supabase migrations, which
# are equally never auto-applied by CI). Regenerate deliberately with
# `npm run sync:content` (at least every 7 days per QURAN-CONTENT.md's
# licensing term) and commit the result — not a build-time side effect.

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — all real .env* files stay untracked/uncommitted, except the
# placeholder-only example file, which must be committed.
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pdf.js worker — copied by scripts/pdf/copy-pdf-worker.mjs (postinstall)
# from whatever pdfjs-dist version react-pdf resolved to on this install.
# Build tooling output, like .next/ — not meant to be hand-tracked.
/public/pdf-worker/

# Raw source Juz PDFs for PDF Mode (see PDF-CONTENT.md) — NOT committed.
# scripts/pdf/strip-watermark.mjs reads these and writes watermark-free
# copies to .pdf-build/juz/ (also gitignored, see below). Kept locally
# only as the working source for regenerating public/pdf/surah/ if the
# source PDFs are ever replaced/updated.
/pdf/

# Watermark-stripped per-Juz PDFs — an intermediate build artifact only
# (input to scripts/pdf/generate-surah-pdfs.mjs), NOT served by the app
# and NOT committed. There is no Juz-level PDF Mode (Juz Mode was
# removed) — public/pdf/surah/ (committed, deliberately, same reasoning
# as chapters.json above) is the only PDF content actually shipped.
# Regenerate with `npm run pdf:strip-watermark`.
/.pdf-build/
