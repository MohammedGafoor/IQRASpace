# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# pdfjs-dist runtime assets (wasm codecs, standard fonts, cmaps) — synced
# from node_modules by scripts/copy-pdfjs-assets.mjs, see PdfViewer.tsx
/public/pdfjs/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — all real .env* files stay untracked/uncommitted...
.env*
# ...except the placeholder-only example file, which must be committed so a
# new developer can find it at all (see .env.local.example's own header).
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
